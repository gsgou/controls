<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-android;$(BaseTargetFramework)-maccatalyst;$(BaseTargetFramework)-macos</TargetFrameworks>
        <!-- Windows packaging (MakePri) only runs on Windows; add the Windows TFM only there so the solution still builds on macOS/Linux. -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
        <SingleProject>true</SingleProject>
        <RootNamespace>Shiny.Maui.Controls.Camera.Documents</RootNamespace>
        <Description>Structured document analyzers for the Shiny CameraView — each document type (Invoice, Receipt, DriversLicense, HealthCard, CreditCard, Passport) is its own analyzer with a strongly-typed event. Driver's licenses (AAMVA PDF417), passports (MRZ) and credit cards (IIN + Luhn) are parsed deterministically; invoices/receipts/health cards via OCR + swappable rules.</Description>
        <PackageTags>maui camera document invoice receipt driverslicense aamva healthcard creditcard passport mrz ocr pdf417</PackageTags>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Maui.Controls.Camera.Ocr\Shiny.Maui.Controls.Camera.Ocr.csproj" />
        <ProjectReference Include="..\Shiny.Maui.Controls.Camera.Barcode\Shiny.Maui.Controls.Camera.Barcode.csproj" />
    </ItemGroup>
</Project>
