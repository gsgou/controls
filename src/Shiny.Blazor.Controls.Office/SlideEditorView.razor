@using Shiny.Blazor.Controls
@using Shiny.Controls.Office.Icons
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Presentation
@using Shiny.Controls.Office.Shapes
@using Shiny.Controls.Office.Spreadsheet

@*
    SlideEditor with editing chrome on top.

    The toolbar is a ShinyToolbar from the core Blazor package, and the pickers in it are the core
    package's own — FontPickerButton, FontSizePickerButton and ColorPickerButton — which is what the
    MAUI SlideEditorView puts in the same three slots.

    The row inside is its own flex container. ShinyToolbar renders ChildContent into a plain block, so
    left to itself every control here would be an inline-level box aligned to the text baseline — and a
    button's baseline, a select's baseline and a swatch's baseline are all in different places.

    Every plain button is an OfficeToolbarButton drawing from the shared icon set — the same artwork,
    at the same weight, as the document toolbar and as both MAUI toolbars. The pickers stay as they
    are: a font, a size and a colour have to show what they are currently set to.
*@
<div class="shiny-slide-editor-view @Class" style="@Style">

    @if (ShowToolbar)
    {
        @*
            The class stays on a div declared here rather than the Ribbon's CssClass: this file's
            scoped rules read `.slide-toolbar ::deep .x`, and the scope id belongs to whatever element
            is declared in *this* file. On a child component's root it is that component's id instead,
            and the stylesheet silently stops matching.
        *@
        <div class="slide-toolbar">
        <Ribbon ShowTabStrip="ShowRibbonTabs"
                AllowCollapse="ShowRibbonTabs"
                SmallItemRows="2"
                HeaderBackgroundColor="@(AccentBackground ?? ToolbarBackground)"
                HeaderForegroundColor="@AccentInk"
                AccentColor="@AccentInk"
                BodyBackgroundColor="@ToolbarBackground">
            <QuickAccess>
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Undo (Ctrl+Z)" Icon="@Ico(OfficeIcon.Undo)"
                              Disabled="@(Disabled || !(Controller?.CanUndo ?? false))"
                              Clicked="() => Run(c => c.Undo())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Redo (Ctrl+Shift+Z)" Icon="@Ico(OfficeIcon.Redo)"
                              Disabled="@(Disabled || !(Controller?.CanRedo ?? false))"
                              Clicked="() => Run(c => c.Redo())" />
            </QuickAccess>

            <ChildContent>
                <RibbonTab Title="Home" Key="home">

                    @* Which slide you are on is navigation, not formatting, so it leads rather than
                       sitting among the text commands. *@
                    <RibbonGroup Title="Slide" Priority="110">
                        @*
                            One hosted strip rather than three items. As separate items the ribbon's
                            column flow stacked the two arrows on top of each other and left the
                            counter alone in the next column - three parts of one control, laid out
                            as though they were unrelated. Large, so the strip centres across the
                            group's rows the way a single tall control should.
                        *@
                        <RibbonContent Size="RibbonItemSize.Large">
                            <div class="slide-nav">
                                <button type="button" class="shiny-office-btn" title="Previous slide"
                                        aria-label="Previous slide"
                                        disabled="@(!CanPrevious)"
                                        @onclick="() => Run(c => c.Previous())">@OfficeToolbarIcons.Get(OfficeIcon.Previous)</button>
                                <span class="slide-count">@(Controller is null ? "—" : $"{Controller.Index + 1}/{Controller.Count}")</span>
                                <button type="button" class="shiny-office-btn" title="Next slide"
                                        aria-label="Next slide"
                                        disabled="@(!CanNext)"
                                        @onclick="() => Run(c => c.Next())">@OfficeToolbarIcons.Get(OfficeIcon.Next)</button>
                            </div>
                        </RibbonContent>
                    </RibbonGroup>

                    <RibbonGroup Title="Font" Priority="100">
                        <RibbonContent Size="RibbonItemSize.Small">
                            <FontPickerButton AvailableFonts="FontFamilies"
                                              SelectedFont="@Format.FontFamily"
                                              Disabled="@(!HasText)"
                                              SelectedFontChanged="OnFontChanged" />
                        </RibbonContent>
                        <RibbonContent Size="RibbonItemSize.Small">
                            <FontSizePickerButton AvailableFontSizes="FontSizes"
                                                  SelectedFontSize="Format.FontSize"
                                                  Disabled="@(!HasText)"
                                                  SelectedFontSizeChanged="OnSizeChanged" />
                        </RibbonContent>

                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bold (Ctrl+B)" Icon="@Ico(OfficeIcon.Bold)"
                                            Checked="Format.Bold" Disabled="@(!HasText)" Clicked="_ => Run(c => c.ToggleBold())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Italic (Ctrl+I)" Icon="@Ico(OfficeIcon.Italic)"
                                            Checked="Format.Italic" Disabled="@(!HasText)" Clicked="_ => Run(c => c.ToggleItalic())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Underline (Ctrl+U)" Icon="@Ico(OfficeIcon.Underline)"
                                            Checked="Format.Underline" Disabled="@(!HasText)" Clicked="_ => Run(c => c.ToggleUnderline())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Strikethrough" Icon="@Ico(OfficeIcon.Strikethrough)"
                                            Checked="Format.Strike" Disabled="@(!HasText)" Clicked="_ => Run(c => c.ToggleStrikethrough())" />

                        <RibbonContent Size="RibbonItemSize.Small">
                            <ColorPickerButton Text="Text colour"
                                               SelectedColor="@ColorHex"
                                               ShowOpacity="false"
                                               Disabled="@(!HasText)"
                                               SelectedColorChanged="OnColorChanged" />
                        </RibbonContent>
                        <RibbonContent Size="RibbonItemSize.Small">
                            <OfficeHighlightButton Current="Format.Highlight"
                                                   Disabled="@(!HasText)"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   Picked="OnHighlightPicked" />
                        </RibbonContent>
                    </RibbonGroup>

                    <RibbonGroup Title="Paragraph" Priority="90">
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align left" Icon="@Ico(OfficeIcon.AlignLeft)"
                                            Checked="@(Format.Alignment == TextAlignment.Left)" Disabled="@(!HasText)"
                                            Clicked="_ => Align(TextAlignment.Left)" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Centre" Icon="@Ico(OfficeIcon.AlignCenter)"
                                            Checked="@(Format.Alignment == TextAlignment.Center)" Disabled="@(!HasText)"
                                            Clicked="_ => Align(TextAlignment.Center)" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align right" Icon="@Ico(OfficeIcon.AlignRight)"
                                            Checked="@(Format.Alignment == TextAlignment.Right)" Disabled="@(!HasText)"
                                            Clicked="_ => Align(TextAlignment.Right)" />

                        <RibbonContent Size="RibbonItemSize.Small">
                            <OfficeWatermarkButton Disabled="Disabled"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   HasWatermark="@(Watermark is not null)"
                                                   Picked="OnWatermarkPicked"
                                                   Rejected="DropRejected" />
                        </RibbonContent>

                        <RibbonSeparator />

                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bulleted list" Icon="@Ico(OfficeIcon.BulletList)"
                                            Checked="@(Format.List == ListStyle.Bullet)" Disabled="@(!HasText)"
                                            Clicked="_ => Run(c => c.ToggleBulletList())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Numbered list" Icon="@Ico(OfficeIcon.NumberedList)"
                                            Checked="@(Format.List == ListStyle.Numbered)" Disabled="@(!HasText)"
                                            Clicked="_ => Run(c => c.ToggleNumberedList())" />

                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Outdent (Shift+Tab)" Icon="@Ico(OfficeIcon.Outdent)"
                                      Disabled="@(!HasText || Format.Level == 0)" Clicked="() => Run(c => c.ShiftLevel(-1))" />
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Indent (Tab)" Icon="@Ico(OfficeIcon.Indent)"
                                      Disabled="@(!HasText)" Clicked="() => Run(c => c.ShiftLevel(1))" />
                    </RibbonGroup>

                    @* Whatever the host added stays on Home: it is the tab that is showing. *@
                    @if (ToolbarContent != null)
                    {
                        <RibbonGroup Title="@ToolbarContentTitle" Priority="200" CanCollapse="false">
                            <RibbonContent>@ToolbarContent</RibbonContent>
                        </RibbonGroup>
                    }
                </RibbonTab>

                @*
                    Two tabs. Home is the slide you are on and the text on it; Insert is what goes on
                    it. The split is only worth making because the second tab holds a real bar - a text
                    box, three ways to place an object and the way to remove one - not a token button.
                *@
                <RibbonTab Title="Insert" Key="insert">
                    <RibbonGroup Title="Insert" Priority="100">
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Add a text box" Icon="@Ico(OfficeIcon.TextBox)"
                                      Disabled="Disabled" Clicked="AddTextBox" />
                        <RibbonContent Size="RibbonItemSize.Small">
                            <OfficeInsertMenu Disabled="Disabled"
                                              ShowTooltips="ShowToolbarTooltips"
                                              ShowShapes="false"
                                              ShapePicked="OnShapePicked"
                                              TablePicked="OnTablePicked"
                                              ImagePicked="OnImagePicked"
                                              ImageRejected="DropRejected" />
                        </RibbonContent>

                        <RibbonSeparator />

                        @* Removing is the opposite of the four beside it, and destructive where they
                           are not - hence the rule in front of it. *@
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Delete the selected shape" Icon="@Ico(OfficeIcon.Delete)"
                                      Disabled="@(!HasSelection)" Clicked="() => Run(c => c.DeleteSelectedShape())" />
                    </RibbonGroup>

                </RibbonTab>

                <OfficeShapesTab Disabled="Disabled" Picked="OnShapePicked" />
            </ChildContent>
        </Ribbon>
        </div>
    }

    <div class="slide-surface">
        <SlideEditor @ref="editor"
                     Deck="Deck"
                     Watermark="Watermark"
                     Theme="Theme"
                     SlideIndex="SlideIndex"
                     SlideIndexChanged="OnSlideIndexChanged"
                     ReadOnly="ReadOnly"
                     SelectionChanged="StateHasChanged"
                     AllowFileDrop="AllowFileDrop"
                     DropRejected="DropRejected"
                     DeckChanged="OnDeckChanged" />
    </div>

    @if (ShowStatus)
    {
        <div class="slide-status">
            @if (Controller is { SelectedShape: >= 0 } controller)
            {
                <span>@(controller.IsEditingText ? "Editing text — double-click a word to select it, Esc to leave" : "Shape selected — double-click to edit its text")</span>
            }
            else
            {
                <span>Click a shape to select it; double-click to edit its text.</span>
            }
        </div>
    }
</div>

@code {
    SlideEditor? editor;

    /// <summary>The deck to edit. Must have been opened with <c>editable: true</c>.</summary>
    [Parameter] public SlideDeck? Deck { get; set; }

    /// <summary>Forwarded to the surface. Unset there means "follow the page's scheme".</summary>
    [Parameter] public SlideTheme? Theme { get; set; }

    [Parameter] public int SlideIndex { get; set; }

    [Parameter] public EventCallback<int> SlideIndexChanged { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>
    /// Whether the icon-only toolbar buttons carry a tooltip naming what they do.
    /// </summary>
    /// <remarks>
    /// On, because every button on this bar is icon only and an icon with no label is a guess until
    /// something names it. Turning it off falls back to the browser's own <c>title</c>, which is
    /// slower to appear and cannot be themed but still says what the button is.
    /// </remarks>
    [Parameter] public bool ShowToolbarTooltips { get; set; } = true;

    /// <summary>A one-line hint under the canvas saying what the current gesture will do.</summary>
    [Parameter] public bool ShowStatus { get; set; } = true;

    /// <summary>Whether dragging an image file onto the slide inserts it. On by default.</summary>
    [Parameter] public bool AllowFileDrop { get; set; } = true;

    /// <summary>Raised when a dropped or chosen file could not be inserted, so a host can say so.</summary>
    [Parameter] public EventCallback<OfficeDropRejected> DropRejected { get; set; }

    /// <summary>Extra items appended to the toolbar, after the built-in controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Group title for <see cref="ToolbarContent"/>.</summary>
    [Parameter] public string ToolbarContentTitle { get; set; } = "Actions";

    /// <summary>Whether the bar shows the ribbon's tab strip, and with it the collapse chevron.</summary>
    /// <remarks>Off by default - one tab in a strip is noise for a bar wrapped around an editor.</remarks>
    /// <summary>
    /// Draw the tab strip. On here, since the bar has Home and Insert.
    /// </summary>
    /// <remarks>
    /// A strip carrying a single "Home" is noise, which is why the spreadsheet bar leaves it off. With
    /// it off here the Insert tab is simply unreachable.
    /// </remarks>
    [Parameter] public bool ShowRibbonTabs { get; set; } = true;

    /// <summary>A shared-set icon as the ribbon takes it: inline SVG markup, not a MarkupString.</summary>
    static string Ico(OfficeIcon icon) => OfficeToolbarIcons.Get(icon).Value;

    [Parameter] public IReadOnlyList<string> FontFamilies { get; set; } =
    [
        "Calibri", "Cambria", "Arial", "Times New Roman", "Georgia", "Verdana", "Courier New"
    ];

    /// <summary>
    /// The sizes the picker offers. Doubles rather than ints so the list matches what a deck can
    /// actually hold — and what the MAUI SlideEditorView takes for the same property.
    /// </summary>
    [Parameter] public IReadOnlyList<double> FontSizes { get; set; } =
    [
        8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 44, 54, 66, 88
    ];

    /// <summary>The size of shape the toolbar inserts, in slide pixels.</summary>
    [Parameter] public double ShapeWidth { get; set; } = 240;

    [Parameter] public double ShapeHeight { get; set; } = 180;

    /// <summary>How wide an inserted picture is, in slide pixels.</summary>
    [Parameter] public double PictureWidth { get; set; } = 400;

    [Parameter] public double ToolbarHeight { get; set; } = 44;
    // Theme tokens rather than literals: the bar sits in the app's chrome, not on the page the
    // editor is drawing, so it has to follow light/dark with everything else. A literal white
    // default left a stark white bar wrapped around a dark editor in dark mode.
    [Parameter] public string ToolbarBackground { get; set; } = "var(--shiny-color-surface-container-low, #FFFFFF)";
    [Parameter] public string ToolbarForeground { get; set; } = "var(--shiny-color-on-surface, #1F2937)";
    [Parameter] public string ToolbarBorder { get; set; } = "var(--shiny-color-outline-variant, #E5E7EB)";

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public EventCallback DeckChanged { get; set; }

    /// <summary>The underlying editor, so a host can focus it or reach its controller.</summary>
    public SlideEditor? Editor => this.editor;

    public SlideEditorController? Controller => this.editor?.Controller;

    bool Disabled => this.ReadOnly || this.Deck is null;

    bool HasSelection => !this.Disabled && this.Controller?.SelectedShape >= 0;

    /// <summary>
    /// Text formatting only applies while a caret is actually inside a shape's text.
    /// </summary>
    /// <remarks>
    /// A live Bold button with nothing to embolden is worse than a disabled one: it tells the user the
    /// click did something.
    /// </remarks>
    bool HasText => !this.Disabled && this.Controller?.IsEditingText == true;

    bool CanNext => this.Controller?.CanGoNext ?? false;
    bool CanPrevious => this.Controller?.CanGoPrevious ?? false;

    SlideCaretFormat Format => this.Controller?.CaretFormat ?? SlideCaretFormat.Default;

    string ColorHex => OfficeColors.ToHex(this.Format.Color);

    async Task Run(Action<SlideEditorController> action)
    {
        if (this.Controller is not { } controller || this.Disabled)
            return;

        action(controller);

        // Focus goes back to the editor after every toolbar action: leaving it on the button means the
        // next keystroke goes nowhere, which reads as the editor having silently stopped working.
        if (this.editor is not null)
            await this.editor.FocusAsync();

        await this.RaiseChangedAsync();
    }

    /// <summary>Drops a new text box into the middle of the slide.</summary>
    Task AddTextBox()
        => this.Run(c => c.AddTextBox(
            Math.Max(0, c.Deck.SlideWidth / 2 - 160),
            Math.Max(0, c.Deck.SlideHeight / 2 - 32)));

    Task OnHighlightPicked(ArgbColor? color) => this.Run(c => c.SetHighlight(color));

    /// <summary>
    /// Drops a new object into the middle of the slide.
    /// </summary>
    /// <remarks>
    /// The middle rather than the top-left, and the same place the text box goes. A slide is an
    /// artboard: something inserted at the origin lands under the title placeholder, where it is both
    /// invisible and awkward to grab.
    /// </remarks>
    static (double X, double Y) Centred(SlideEditorController controller, double width, double height)
        => (Math.Max(0, (controller.Deck.SlideWidth - width) / 2),
            Math.Max(0, (controller.Deck.SlideHeight - height) / 2));

    Task OnShapePicked(ShapeGeometry geometry) => this.Run(c =>
    {
        var (x, y) = Centred(c, this.ShapeWidth, this.ShapeHeight);
        c.AddShape(geometry, x, y, this.ShapeWidth, this.ShapeHeight);
    });

    Task OnTablePicked((int Rows, int Columns) size) => this.Run(c =>
    {
        // Sized to the slide rather than to the grid: a 2x2 and an 8x8 both want to be a table on a
        // slide, not a postage stamp and something that overflows the edge.
        var width = c.Deck.SlideWidth * 0.7;
        var height = Math.Min(c.Deck.SlideHeight * 0.6, size.Rows * 44);
        var (x, y) = Centred(c, width, height);

        c.AddTable(size.Rows, size.Columns, x, y, width, height);
    });

    Task OnImagePicked(OfficePickedImage image) => this.Run(c =>
    {
        var width = Math.Min(c.Deck.SlideWidth / 2, this.PictureWidth);
        var height = width * 0.75;
        var (x, y) = Centred(c, width, height);

        c.AddPicture(image.Data, image.ContentType, x, y, width, height, Path.GetFileNameWithoutExtension(image.FileName));
    });

    Task Align(TextAlignment alignment) => this.Run(c => c.SetAlignment(alignment));

    Task OnFontChanged(string family)
        => family is { Length: > 0 }
            ? this.Run(c => c.SetFontFamily(family))
            : Task.CompletedTask;

    Task OnSizeChanged(double size)
        => size > 0
            ? this.Run(c => c.SetFontSize(size))
            : Task.CompletedTask;

    Task OnColorChanged(string hex)
        => OfficeColors.TryParse(hex, out var color)
            ? this.Run(c => c.SetTextColor(color))
            : Task.CompletedTask;

    async Task OnSlideIndexChanged(int index)
    {
        this.SlideIndex = index;

        if (this.SlideIndexChanged.HasDelegate)
            await this.SlideIndexChanged.InvokeAsync(index);

        this.StateHasChanged();
    }

    async Task OnDeckChanged() => await this.RaiseChangedAsync();

    async Task RaiseChangedAsync()
    {
        this.StateHasChanged();

        if (this.DeckChanged.HasDelegate)
            await this.DeckChanged.InvokeAsync();
    }

    /// <summary>
    /// The colour this control wears: its ribbon's header band and tab underline.
    /// </summary>
    /// <remarks>
    /// Defaults to <see cref="OfficeAccent.Presentation"/> - the colour Microsoft's own PowerPoint wears,
    /// because that is what a user reads as "slides" before any label has been looked at. Set it to
    /// take on the app's own brand instead, or to <c>null</c> to leave the bar on the theme's neutrals
    /// like the rest of the chrome.
    /// </remarks>
    [Parameter] public OfficeAccent? Accent { get; set; } = OfficeAccent.Presentation;

    string? AccentBackground => this.Accent is { } a ? Css(a.Color) : null;

    string? AccentInk => this.Accent is { } a ? Css(a.Ink) : null;

    static string Css(ArgbColor value)
        => $"rgba({value.R},{value.G},{value.B},{(value.A / 255d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";


    /// <summary>A picture drawn behind the slide. Forwarded to the surface.</summary>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

    Task OnWatermarkPicked(OfficeWatermark? mark)
    {
        this.Watermark = mark;
        this.StateHasChanged();
        return Task.CompletedTask;
    }

}
