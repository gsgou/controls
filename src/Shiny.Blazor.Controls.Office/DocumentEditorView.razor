@using Shiny.Blazor.Controls
@using Shiny.Controls.Office.Document
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Shapes
@using Shiny.Controls.Office.Spreadsheet

@*
    DocumentEditor with formatting chrome on top.

    The toolbar is a ShinyToolbar from the core Blazor package, filled through its ChildContent, and
    the pickers in it are the core package's own — FontPickerButton, FontSizePickerButton and
    ColorPickerButton — which is what the MAUI DocumentEditorView puts in the same three slots.

    The row inside is its own flex container. ShinyToolbar renders ChildContent into a plain block, so
    left to itself every control here would be an inline-level box on a text line, aligned to the text
    baseline — and a button's baseline, a select's baseline and a swatch's baseline are all in
    different places, which is exactly what "the toolbar buttons look slightly off" is.
*@
<div class="shiny-doc-editor-view @Class" style="@Style">

    @if (ShowToolbar)
    {
        <ShinyToolbar Dock="ToolbarDock.Top"
                      Sticky="false"
                      Height="@ToolbarHeight"
                      BackgroundColor="@ToolbarBackground"
                      TextColor="@ToolbarForeground"
                      HasShadow="false"
                      BorderColor="@ToolbarBorder"
                      BorderThickness="1"
                      OverflowEnabled="false"
                      SafeArea="false"
                      ZIndex="5">

        <div class="doc-toolbar">

            <FontPickerButton AvailableFonts="FontFamilies"
                              SelectedFont="@Format.FontFamily"
                              Disabled="Disabled"
                              SelectedFontChanged="OnFontChanged" />

            <FontSizePickerButton AvailableFontSizes="FontSizes"
                                  SelectedFontSize="Format.FontSize"
                                  Disabled="Disabled"
                                  SelectedFontSizeChanged="OnSizeChanged" />

            <span class="doc-sep"></span>

            <button class="doc-btn @(Format.Bold ? "on" : null)" title="Bold (Ctrl+B)" disabled="@Disabled" @onclick="() => Run(c => c.ToggleBold())"><b>B</b></button>
            <button class="doc-btn @(Format.Italic ? "on" : null)" title="Italic (Ctrl+I)" disabled="@Disabled" @onclick="() => Run(c => c.ToggleItalic())"><i>I</i></button>
            <button class="doc-btn @(Format.Underline ? "on" : null)" title="Underline (Ctrl+U)" disabled="@Disabled" @onclick="() => Run(c => c.ToggleUnderline())"><u>U</u></button>
            <button class="doc-btn @(Format.Strike ? "on" : null)" title="Strikethrough" disabled="@Disabled" @onclick="() => Run(c => c.ToggleStrikethrough())"><s>S</s></button>

            <span class="doc-sep"></span>

            <ColorPickerButton Text="Text colour"
                               SelectedColor="@ColorHex"
                               ShowOpacity="false"
                               Disabled="Disabled"
                               SelectedColorChanged="OnColorChanged" />

            <OfficeHighlightButton Current="Format.Highlight"
                                   Disabled="Disabled"
                                   Picked="OnHighlightPicked" />

            <span class="doc-sep"></span>

            <OfficeInsertMenu Disabled="Disabled"
                              ShapePicked="OnShapePicked"
                              TablePicked="OnTablePicked"
                              ImagePicked="OnImagePicked"
                              ImageRejected="DropRejected" />

            <span class="doc-sep"></span>

            <button class="doc-btn @(Format.Alignment == TextAlignment.Left ? "on" : null)" title="Align left" disabled="@Disabled" @onclick="() => Align(TextAlignment.Left)">⯇</button>
            <button class="doc-btn @(Format.Alignment == TextAlignment.Center ? "on" : null)" title="Centre" disabled="@Disabled" @onclick="() => Align(TextAlignment.Center)">≡</button>
            <button class="doc-btn @(Format.Alignment == TextAlignment.Right ? "on" : null)" title="Align right" disabled="@Disabled" @onclick="() => Align(TextAlignment.Right)">⯈</button>
            <button class="doc-btn @(Format.Alignment == TextAlignment.Justify ? "on" : null)" title="Justify" disabled="@Disabled" @onclick="() => Align(TextAlignment.Justify)">▤</button>

            <span class="doc-sep"></span>

            <button class="doc-btn" title="Undo (Ctrl+Z)" disabled="@(Disabled || !(editor?.Controller?.CanUndo ?? false))" @onclick="() => Run(c => c.Undo())">↶</button>
            <button class="doc-btn" title="Redo (Ctrl+Shift+Z)" disabled="@(Disabled || !(editor?.Controller?.CanRedo ?? false))" @onclick="() => Run(c => c.Redo())">↷</button>

            @ToolbarContent
        </div>
        </ShinyToolbar>
    }

    <div class="doc-surface">
        <DocumentEditor @ref="editor"
                        Document="Document"
                        Theme="Theme"
                        Zoom="Zoom"
                        ReadOnly="ReadOnly"
                        SpellChecker="SpellChecker"
                        SpellCheckEnabled="SpellCheckEnabled"
                        AllowFileDrop="AllowFileDrop"
                        DropRejected="DropRejected"
                        DocumentChanged="OnDocumentChanged" />
    </div>
</div>

@code {
    DocumentEditor? editor;

    [Parameter] public WordDocument? Document { get; set; }

    [Parameter] public DocumentTheme Theme { get; set; } = DocumentTheme.Light;

    [Parameter] public double Zoom { get; set; } = 1.0;

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Passed straight through to the inner <see cref="DocumentEditor"/>.</summary>
    [Parameter] public ISpellChecker? SpellChecker { get; set; }

    [Parameter] public bool SpellCheckEnabled { get; set; } = true;

    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Whether dragging an image file onto the document inserts it. On by default.</summary>
    [Parameter] public bool AllowFileDrop { get; set; } = true;

    /// <summary>Raised when a dropped or chosen file could not be inserted, so a host can say so.</summary>
    [Parameter] public EventCallback<OfficeDropRejected> DropRejected { get; set; }

    /// <summary>The size of shape the toolbar inserts, in pixels.</summary>
    [Parameter] public double ShapeWidth { get; set; } = 160;

    [Parameter] public double ShapeHeight { get; set; } = 120;

    /// <summary>How wide an inserted picture is, in pixels. Its height follows the image's own ratio.</summary>
    [Parameter] public double PictureWidth { get; set; } = 240;

    /// <summary>Extra items appended to the toolbar, after the built-in formatting controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    [Parameter] public IReadOnlyList<string> FontFamilies { get; set; } =
    [
        "Calibri", "Cambria", "Arial", "Times New Roman", "Georgia", "Verdana", "Courier New"
    ];

    /// <summary>
    /// The sizes the picker offers. Doubles rather than ints so the list matches what a document can
    /// actually hold — and what the MAUI DocumentEditorView takes for the same property.
    /// </summary>
    [Parameter] public IReadOnlyList<double> FontSizes { get; set; } =
    [
        8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48, 72
    ];

    [Parameter] public double ToolbarHeight { get; set; } = 44;
    [Parameter] public string ToolbarBackground { get; set; } = "#FFFFFF";
    [Parameter] public string ToolbarForeground { get; set; } = "#1F2937";
    [Parameter] public string ToolbarBorder { get; set; } = "#E5E7EB";

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public EventCallback DocumentChanged { get; set; }

    /// <summary>The underlying editor, so a host can focus it or reach its controller.</summary>
    public DocumentEditor? Editor => this.editor;

    public DocumentEditorController? Controller => this.editor?.Controller;

    bool Disabled => this.ReadOnly || this.Document is null;

    CaretFormat Format => this.editor?.Controller?.CaretFormat ?? CaretFormat.Default;

    string ColorHex => OfficeColors.ToHex(this.Format.Color);

    async Task Run(Action<DocumentEditorController> action)
    {
        if (this.editor?.Controller is not { } controller || this.Disabled)
            return;

        action(controller);

        // Focus goes back to the editor after every toolbar action: leaving it on the button means the
        // next keystroke goes nowhere, which reads as the editor having silently stopped working.
        await this.editor.FocusAsync();
        await this.RaiseChangedAsync();
    }

    Task Align(TextAlignment alignment) => this.Run(c => c.SetAlignment(alignment));

    Task OnFontChanged(string family)
        => family is { Length: > 0 }
            ? this.Run(c => c.SetFontFamily(family))
            : Task.CompletedTask;

    Task OnSizeChanged(double size)
        => size > 0
            ? this.Run(c => c.SetFontSize(size))
            : Task.CompletedTask;

    Task OnColorChanged(string hex)
        => OfficeColors.TryParse(hex, out var color)
            ? this.Run(c => c.SetTextColor(color))
            : Task.CompletedTask;

    Task OnHighlightPicked(ArgbColor? color) => this.Run(c => c.SetHighlight(color));

    Task OnShapePicked(ShapeGeometry geometry)
        => this.Run(c => c.InsertShape(geometry, this.ShapeWidth, this.ShapeHeight));

    Task OnTablePicked((int Rows, int Columns) size)
        => this.Run(c => c.InsertTable(size.Rows, size.Columns));

    Task OnImagePicked(OfficePickedImage image)
        => this.Run(c => c.InsertImage(
            image.Data,
            image.ContentType,
            this.PictureWidth,
            name: Path.GetFileNameWithoutExtension(image.FileName)));

    async Task OnDocumentChanged() => await this.RaiseChangedAsync();

    async Task RaiseChangedAsync()
    {
        this.StateHasChanged();

        if (this.DocumentChanged.HasDelegate)
            await this.DocumentChanged.InvokeAsync();
    }
}
