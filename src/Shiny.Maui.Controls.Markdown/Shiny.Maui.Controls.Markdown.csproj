<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls"/>
        <PackageReference Include="Markdig"/>
    </ItemGroup>

    <ItemGroup>
        <!-- For the keyboard accessory bar: the editor hands its toolbar to the same
             KeyboardAccessoryView the core package docks to the soft keyboard, rather than growing a
             second copy of the iOS/Android plumbing behind it. -->
        <ProjectReference Include="..\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj" />
    </ItemGroup>
</Project>
