<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            The view is an SKCanvasView and the engine is portable: iOS, Android, Mac Catalyst and
            Windows all resolve SkiaSharp's own platform assets through the app's reference to it, so
            the plain net10.0 build serves them.

            net10.0-macos (AppKit) is the exception. SkiaSharp.Views.Maui ships no macos asset, so that
            head's SKCanvasViewHandler throws where the platform view should be and the plan came up
            blank. The AppKit handler is compiled in from Shiny.Maui.Controls.Office (one source, an
            internal copy here) and UseShinyFloorPlan registers it.
        -->
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-macos</TargetFrameworks>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Maui.Controls.FloorPlan</RootNamespace>
        <Description>An interactive floor plan for .NET MAUI - rooms, walls, doors, cubicles, outlets, furniture and custom SVG stencils on a pan/zoom SkiaSharp canvas, with drawing and placement tools, snap-to-grid, selection and resize handles in edit mode, and tap-to-identify in view mode for seating charts.</Description>
        <PackageTags>maui shiny floorplan cad seating layout skiasharp</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls"/>
        <PackageReference Include="SkiaSharp.Views.Maui.Controls"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'macos'">
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS"/>
        <Compile Include="..\Shiny.Maui.Controls.Office\Platforms\AppKit\SkiaCanvasNSView.cs" Link="AppKit\SkiaCanvasNSView.cs"/>
        <Compile Include="..\Shiny.Maui.Controls.Office\Platforms\AppKit\MacOSSKCanvasViewHandler.cs" Link="AppKit\MacOSSKCanvasViewHandler.cs"/>
    </ItemGroup>

    <!-- On the TFM, not TargetPlatformIdentifier: that is inferred after the project body, so a
         PropertyGroup conditioned on it never applies (item conditions are evaluated later and do). -->
    <PropertyGroup Condition="$(TargetFramework.EndsWith('-macos'))">
        <DefineConstants>$(DefineConstants);SHINY_APPKIT_SKIA_COPY</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.FloorPlan.Shared\Shiny.Controls.FloorPlan.Shared.csproj"/>

        <!-- For ShinyThemeKeys: an unthemed plan is a white sheet inside a dark app, and the keys are
             the only way to ask the app what its own neutrals are. -->
        <ProjectReference Include="..\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj"/>
    </ItemGroup>

</Project>
