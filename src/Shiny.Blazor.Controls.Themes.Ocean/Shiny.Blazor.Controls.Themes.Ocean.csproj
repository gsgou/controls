<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Blazor.Controls.Themes.Ocean</RootNamespace>
        <Description>Ocean theme pack for Shiny.Blazor.Controls — a cool teal/cyan Material 3 palette. Link _content/Shiny.Blazor.Controls.Themes.Ocean/css/shiny-theme-ocean.css after the core theme.</Description>
        <PackageTags>blazor shiny controls theme ocean material3</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

</Project>
