<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Blazor.Controls.Kiosk</RootNamespace>
        <Description>Kiosk-shaped Blazor controls — Visual-Studio-style window docking (dockable tool windows, tabbed groups, splitters, auto-hide rails, in-app floating panels) and an on-screen keyboard for touch tablets / kiosks. Pairs with the MAUI-side Shiny.Maui.Controls.Desktop add-on.</Description>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>
</Project>
