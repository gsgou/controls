<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-android;$(BaseTargetFramework)-maccatalyst;$(BaseTargetFramework)-macos</TargetFrameworks>
        <!-- Windows packaging (MakePri) only runs on Windows; add the Windows TFM only there so the solution still builds on macOS/Linux. -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
        <SingleProject>true</SingleProject>
        <RootNamespace>Shiny.Maui.Controls.Camera.Ai</RootNamespace>
        <Description>AI document scanner analyzer for the Shiny CameraView. Cheaply detects that a document is present in a frame (Apple Vision segmentation / managed edge detection), then ships just that one frame to a Microsoft.Extensions.AI IChatClient for structured data extraction — so the model only runs on real documents, not every frame. Works with any IChatClient (Azure OpenAI, OpenAI, Ollama, …) and any strongly-typed payload via MEAI structured output.</Description>
        <PackageTags>maui camera document scanner ai llm openai chatclient microsoft.extensions.ai ocr vision structured-output</PackageTags>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Camera.Shared\Shiny.Controls.Camera.Shared.csproj" />
        <ProjectReference Include="..\Shiny.Maui.Controls.Camera\Shiny.Maui.Controls.Camera.csproj" />
        <PackageReference Include="Microsoft.Extensions.AI" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Platforms/**/*.cs" />
        <None Include="Platforms/**/*.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst' Or '$(TargetPlatformIdentifier)' == 'macos'">
        <Compile Include="Platforms/Apple/**/*.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
        <Compile Include="Platforms/Android/**/*.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
        <Compile Include="Platforms/Windows/**/*.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == ''">
        <Compile Include="Platforms/Managed/**/*.cs" />
    </ItemGroup>

    <Target Name="_ReincludeNonMauiPlatforms" BeforeTargets="_MauiRemovePlatformCompileItems" Condition="'$(SingleProject)' == 'true'">
        <ItemGroup>
            <Compile Update="Platforms/Apple/**/*.cs" Condition="'$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst' Or '$(TargetPlatformIdentifier)' == 'macos'">
                <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
            </Compile>
            <Compile Update="Platforms/Managed/**/*.cs" Condition="'$(TargetPlatformIdentifier)' == ''">
                <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
            </Compile>
        </ItemGroup>
    </Target>
</Project>
