<!-- Razor SDK, like every other Blazor add-on here: without it wwwroot is not published as a
     static web asset and the package's JS modules 404 under /_content/. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Blazor.Controls\Shiny.Blazor.Controls.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Shiny.Speech"/>
    </ItemGroup>
</Project>
