<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Headless by design: no MAUI host, no display link. Kept off the platform TFMs so the
             Skia dependency never reaches apps that only animate views. -->
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- The repo uses two feeds (nuget.org + dotnet10) without source mapping; NU1507 is a
             restore-config warning, not a code-quality one, so it must not fail these builds. -->
        <NoWarn>$(NoWarn);NU1507</NoWarn>
        <RootNamespace>Shiny.Maui.Controls.Keyframe.Export</RootNamespace>
        <Description>Deterministic offscreen frame export for Shiny Keyframe scenes — lazily yielded frames rendered through Skia, plus a pure-managed GIF encoder.</Description>
        <PackageTags>maui shiny keyframe animation export gif render offscreen</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Graphics.Skia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Keyframe.Shared\Shiny.Controls.Keyframe.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Shiny.Controls.Keyframe" />
    </ItemGroup>

</Project>
