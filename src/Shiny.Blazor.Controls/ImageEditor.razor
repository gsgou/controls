@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="shiny-imgeditor" @ref="rootEl">
    <div class="shiny-imgeditor-canvas-container">
        <canvas class="shiny-imgeditor-canvas" @ref="canvasEl"></canvas>

        @if (isTextInputVisible)
        {
            <input class="shiny-imgeditor-text-input"
                   @ref="textInputEl"
                   @bind="textInputValue"
                   @bind:event="oninput"
                   @onkeydown="OnTextInputKeyDown"
                   @onblur="CommitTextInput"
                   style="left:@(textInputLeft.ToString(Culture))px;top:@(textInputTop.ToString(Culture))px;font-size:@((TextFontSize * textInputScale).ToString(Culture))px;color:@(activeColor);font-family:@(TextFontFamily);" />
        }
    </div>

    @if (ToolbarTemplate != null)
    {
        <div class="shiny-imgeditor-toolbar">
            @ToolbarTemplate
        </div>
    }
    else if (currentMode == "crop")
    {
        @* Crop is modal — a focused confirm/cancel bar rather than the full tool set *@
        <div class="shiny-imgeditor-toolbar @ToolbarOrderClass">
            <div class="shiny-imgeditor-bar shiny-imgeditor-bar--crop">
                <button class="shiny-imgeditor-pill shiny-imgeditor-pill--ghost"
                        @onclick="CancelCrop">@CropCancelText</button>
                <span class="shiny-imgeditor-hint">Drag the edges to crop</span>
                <button class="shiny-imgeditor-pill shiny-imgeditor-pill--accent"
                        @onclick="ApplyCrop">@CropApplyText</button>
            </div>
        </div>
    }
    else
    {
        <div class="shiny-imgeditor-toolbar @ToolbarOrderClass">
            <div class="shiny-imgeditor-bar">

                @* Tools — scrolls horizontally so the row never runs off a narrow screen *@
                <div class="shiny-imgeditor-scroller">
                    <div class="shiny-imgeditor-tools">
                        @if (AllowZoom)
                        {
                            <button class="shiny-imgeditor-tool @Active("none")" @onclick="SelectMoveTool" title="Move">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Move</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Move</span> }
                            </button>
                        }
                        @if (AllowCrop)
                        {
                            <button class="shiny-imgeditor-tool @Active("crop")" @onclick="ToggleCrop" title="Crop">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Crop</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Crop</span> }
                            </button>
                        }
                        @if (AllowRotate)
                        {
                            <button class="shiny-imgeditor-tool" @onclick="RotateClockwise" title="Rotate">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Rotate</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Rotate</span> }
                            </button>
                        }
                        @if (AllowDraw)
                        {
                            <button class="shiny-imgeditor-tool @Active("draw")" @onclick="ToggleDraw" title="Draw">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Draw</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Draw</span> }
                            </button>
                        }
                        @if (AllowLine)
                        {
                            <button class="shiny-imgeditor-tool @Active("line")" @onclick="ToggleLine" title="Line">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Line</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Line</span> }
                            </button>
                        }
                        @if (AllowArrow)
                        {
                            <button class="shiny-imgeditor-tool @Active("arrow")" @onclick="ToggleArrow" title="Arrow">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Arrow</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Arrow</span> }
                            </button>
                        }
                        @if (AllowRectangle)
                        {
                            <button class="shiny-imgeditor-tool @Active("rect")" @onclick="ToggleRectangle" title="Rectangle">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Rectangle</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Rect</span> }
                            </button>
                        }
                        @if (AllowEllipse)
                        {
                            <button class="shiny-imgeditor-tool @Active("ellipse")" @onclick="ToggleEllipse" title="Ellipse">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Ellipse</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Ellipse</span> }
                            </button>
                        }
                        @if (AllowCircle)
                        {
                            <button class="shiny-imgeditor-tool @Active("circle")" @onclick="ToggleCircle" title="Circle">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Circle</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Circle</span> }
                            </button>
                        }
                        @if (AllowTextAnnotation)
                        {
                            <button class="shiny-imgeditor-tool @Active("text")" @onclick="ToggleText" title="Text">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.Text</span>
                                @if (ShowToolLabels) { <span class="shiny-imgeditor-cap">Text</span> }
                            </button>
                        }
                    </div>
                </div>

                @* Options for the active tool only *@
                @if (IsInkMode || IsShapeMode || currentMode == "text")
                {
                    <div class="shiny-imgeditor-scroller">
                        <div class="shiny-imgeditor-options">
                            @* For a shape this swatch and these weights are the border — the
                               interior gets its own swatch, opacity and on/off toggle below *@
                            <input type="color" class="shiny-imgeditor-color" value="@activeColor"
                                   @onchange="OnColorChanged" title="Colour" />

                            @if ((IsInkMode || IsShapeMode) && ShowStrokeWidthPicker)
                            {
                                @foreach (var width in StrokeWidthPresets)
                                {
                                    var w = width;
                                    <button class="shiny-imgeditor-weight @(IsSelectedWidth(w) ? "active" : "")"
                                            @onclick="() => SetStrokeWidthAsync(w)" title="@($"{w}px")">
                                        <span style="width:@((6 + w * 1.6).ToString(Culture))px;height:@((6 + w * 1.6).ToString(Culture))px"></span>
                                    </button>
                                }
                            }

                            @if (IsShapeMode && ShowShapeFillPicker)
                            {
                                <span class="shiny-imgeditor-divider"></span>
                                <input type="color" class="shiny-imgeditor-color" value="@shapeFillHex"
                                       @onchange="OnFillColorChanged" title="Fill colour" />
                                <input type="range" class="shiny-imgeditor-range" min="0" max="100" step="1"
                                       value="@FillOpacityPercent" @onchange="OnFillOpacityChanged"
                                       title="Fill opacity" aria-label="Fill opacity" />
                                <button class="shiny-imgeditor-btn @(shapeFill == null ? "" : "active")"
                                        @onclick="ToggleShapeFill"
                                        title="@(shapeFill == null ? "No fill" : "Fill")">
                                    <span class="shiny-imgeditor-ico">@(shapeFill == null ? ImageEditorIcons.NoFill : ImageEditorIcons.Fill)</span>
                                </button>
                            }

                            @if (currentMode == "text" && AllowFontSelection && AvailableFonts != null)
                            {
                                <select class="shiny-imgeditor-select" @onchange="OnFontFamilySelected" title="Font">
                                    @foreach (var font in AvailableFonts)
                                    {
                                        <option value="@font" selected="@(font == TextFontFamily)" style="font-family:@font">@font</option>
                                    }
                                </select>
                            }
                            @if (currentMode == "text" && AllowFontSizeSelection && AvailableFontSizes != null)
                            {
                                <select class="shiny-imgeditor-select" @onchange="OnFontSizeSelected" title="Font size">
                                    @foreach (var size in AvailableFontSizes)
                                    {
                                        <option value="@size.ToString(Culture)"
                                                selected="@(System.Math.Abs(size - TextFontSize) < 0.001)">@size pt</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                }

                @* History on the left, zoom in the middle *@
                <div class="shiny-imgeditor-actions">
                    <div class="shiny-imgeditor-group">
                        <button class="shiny-imgeditor-btn" @onclick="Undo" disabled="@(!canUndo)" title="Undo">
                            <span class="shiny-imgeditor-ico">@ImageEditorIcons.Undo</span>
                        </button>
                        <button class="shiny-imgeditor-btn" @onclick="Redo" disabled="@(!canRedo)" title="Redo">
                            <span class="shiny-imgeditor-ico">@ImageEditorIcons.Redo</span>
                        </button>
                        <button class="shiny-imgeditor-btn" @onclick="Reset" disabled="@(!canUndo)" title="Reset">
                            <span class="shiny-imgeditor-ico">@ImageEditorIcons.Reset</span>
                        </button>
                    </div>

                    @if (AllowZoom && ShowZoomControls)
                    {
                        <div class="shiny-imgeditor-group shiny-imgeditor-group--zoom">
                            <button class="shiny-imgeditor-btn" @onclick="ZoomOut" title="Zoom out">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.ZoomOut</span>
                            </button>
                            <button class="shiny-imgeditor-zoomvalue" @onclick="ZoomToFit" title="Reset zoom">@ZoomText</button>
                            <button class="shiny-imgeditor-btn" @onclick="ZoomIn" title="Zoom in">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.ZoomIn</span>
                            </button>
                            <button class="shiny-imgeditor-btn" @onclick="ZoomToFit" title="Fit to view">
                                <span class="shiny-imgeditor-ico">@ImageEditorIcons.ZoomFit</span>
                            </button>
                        </div>
                    }

                    <div class="shiny-imgeditor-group shiny-imgeditor-group--end">
                        @ToolbarActions
                    </div>
                </div>
            </div>
        </div>
    }
</div>
