@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="shiny-imgeditor" @ref="rootEl">
    <div class="shiny-imgeditor-canvas-container">
        <canvas class="shiny-imgeditor-canvas" @ref="canvasEl"></canvas>

        @if (isTextInputVisible)
        {
            <input class="shiny-imgeditor-text-input"
                   @ref="textInputEl"
                   @bind="textInputValue"
                   @bind:event="oninput"
                   @onkeydown="OnTextInputKeyDown"
                   @onblur="CommitTextInput"
                   style="left:@(textInputLeft.ToString(Culture))px;top:@(textInputTop.ToString(Culture))px;font-size:@((TextFontSize * textInputScale).ToString(Culture))px;color:@(activeColor);font-family:@(TextFontFamily);" />
        }
    </div>

    @if (ToolbarTemplate != null)
    {
        <div class="shiny-imgeditor-toolbar">
            @ToolbarTemplate
        </div>
    }
    else if (currentMode == "crop")
    {
        @* Crop is modal — a focused confirm/cancel bar rather than the full tool set *@
        <div class="shiny-imgeditor-toolbar @ToolbarOrderClass">
            <div class="shiny-imgeditor-bar shiny-imgeditor-bar--crop">
                <button class="shiny-imgeditor-pill shiny-imgeditor-pill--ghost"
                        @onclick="CancelCrop">@CropCancelText</button>
                <span class="shiny-imgeditor-hint">Drag the edges to crop</span>
                <button class="shiny-imgeditor-pill shiny-imgeditor-pill--accent"
                        @onclick="ApplyCrop">@CropApplyText</button>
            </div>
        </div>
    }
    else
    {
        @*
            The ribbon is the toolbar now. The tools were already grouped the way a ribbon wants them,
            and it earns its keep on the options row: those used to be an unlabelled strip that changed
            shape under the buttons that caused it, and they are a captioned contextual tab here.

            Every item is Small rather than the ribbon's Large default - a dozen large buttons is not a
            palette, and Simplified keeps a label only on items declared Small, so a mix of sizes gave a
            row where some tools were labelled and some were bare icons.
        *@
        <div class="shiny-imgeditor-toolbar @ToolbarOrderClass">
            @* Two rows, not the ribbon's three: a shorter bar matters more here than in a document app,
               and the editor's groups divide more evenly over two. *@
            <Ribbon @bind-SelectedKey="ribbonTabKey"
                    @bind-DisplayMode="ribbonDisplayMode"
                    SmallItemRows="2"
                    CssClass="shiny-imgeditor-ribbon">
                <QuickAccess>
                    @* Undo, redo and reset apply to every tool, so they sit outside the tabs and never
                       move or disappear when the tab does. *@
                    <RibbonButton Size="RibbonItemSize.Small" Tooltip="Undo" Icon="@ImageEditorIcons.Undo.Value"
                                  Disabled="@(!canUndo)" Clicked="Undo" />
                    <RibbonButton Size="RibbonItemSize.Small" Tooltip="Redo" Icon="@ImageEditorIcons.Redo.Value"
                                  Disabled="@(!canRedo)" Clicked="Redo" />
                    <RibbonButton Size="RibbonItemSize.Small" Tooltip="Reset" Icon="@ImageEditorIcons.Reset.Value"
                                  Disabled="@(!canUndo)" Clicked="Reset" />
                </QuickAccess>

                <ChildContent>
                <RibbonTab Title="Home" Key="home">
                    <RibbonGroup Title="Tools" Priority="100">
                        @if (AllowZoom)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Move" Tooltip="Move"
                                                Icon="@ImageEditorIcons.Move.Value"
                                                Checked="@(currentMode == "none")" Clicked="_ => SelectMoveTool()" />
                        }
                        @if (AllowCrop)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Crop" Tooltip="Crop"
                                                Icon="@ImageEditorIcons.Crop.Value"
                                                Checked="@(currentMode == "crop")" Clicked="_ => ToggleCrop()" />
                        }
                        @if (AllowDraw)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Draw" Tooltip="Draw"
                                                Icon="@ImageEditorIcons.Draw.Value"
                                                Checked="@(currentMode == "draw")" Clicked="_ => ToggleDraw()" />
                        }
                        @if (AllowTextAnnotation)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Text" Tooltip="Text"
                                                Icon="@ImageEditorIcons.Text.Value"
                                                Checked="@(currentMode == "text")" Clicked="_ => ToggleText()" />
                        }
                    </RibbonGroup>

                    <RibbonGroup Title="Shapes" Priority="60">
                        @if (AllowLine)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Line" Tooltip="Line"
                                                Icon="@ImageEditorIcons.Line.Value"
                                                Checked="@(currentMode == "line")" Clicked="_ => ToggleLine()" />
                        }
                        @if (AllowArrow)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Arrow" Tooltip="Arrow"
                                                Icon="@ImageEditorIcons.Arrow.Value"
                                                Checked="@(currentMode == "arrow")" Clicked="_ => ToggleArrow()" />
                        }
                        @if (AllowRectangle)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Rectangle" Tooltip="Rectangle"
                                                Icon="@ImageEditorIcons.Rectangle.Value"
                                                Checked="@(currentMode == "rect")" Clicked="_ => ToggleRectangle()" />
                        }
                        @if (AllowEllipse)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Ellipse" Tooltip="Ellipse"
                                                Icon="@ImageEditorIcons.Ellipse.Value"
                                                Checked="@(currentMode == "ellipse")" Clicked="_ => ToggleEllipse()" />
                        }
                        @if (AllowCircle)
                        {
                            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Circle" Tooltip="Circle"
                                                Icon="@ImageEditorIcons.Circle.Value"
                                                Checked="@(currentMode == "circle")" Clicked="_ => ToggleCircle()" />
                        }
                    </RibbonGroup>

                    @if (AllowRotate || ToolbarActions != null)
                    {
                        @* Rotate and the host's actions share a group rather than taking one each: a
                           group costs a divider and a title whatever is in it, so two one-item groups
                           spent more width on chrome than on commands. CanCollapse is off because the
                           host's actions are in here - whatever they are, they are the reason the
                           editor is open, and they must never fold into an overflow button. *@
                        <RibbonGroup Title="Image" Priority="200" CanCollapse="false">
                            @if (AllowRotate)
                            {
                                <RibbonButton Size="RibbonItemSize.Small" Text="Rotate" Tooltip="Rotate"
                                              Icon="@ImageEditorIcons.Rotate.Value" Clicked="RotateClockwise" />
                            }
                            @if (ToolbarActions != null)
                            {
                                <RibbonContent>@ToolbarActions</RibbonContent>
                            }
                        </RibbonGroup>
                    }
                </RibbonTab>

                @if (AllowZoom && ShowZoomControls)
                {
                    <RibbonTab Title="View" Key="view">
                        <RibbonGroup Title="Zoom">
                            <RibbonButton Size="RibbonItemSize.Small" Text="Out" Tooltip="Zoom out"
                                          Icon="@ImageEditorIcons.ZoomOut.Value" Clicked="ZoomOut" />
                            <RibbonButton Size="RibbonItemSize.Small" Text="In" Tooltip="Zoom in"
                                          Icon="@ImageEditorIcons.ZoomIn.Value" Clicked="ZoomIn" />
                            <RibbonButton Size="RibbonItemSize.Small" Text="Fit" Tooltip="Fit to view"
                                          Icon="@ImageEditorIcons.ZoomFit.Value" Clicked="ZoomToFit" />
                            <RibbonContent>
                                @* A value, not a command, so it is hosted rather than made a button. *@
                                <button class="shiny-imgeditor-zoomvalue" @onclick="ZoomToFit" title="Reset zoom">@ZoomText</button>
                            </RibbonContent>
                        </RibbonGroup>
                    </RibbonTab>
                }

                @if (IsInkMode || IsShapeMode || currentMode == "text")
                {
                    @* Contextual: the band above the strip is what says these options belong to the
                       tool you just picked rather than to the picture. *@
                    <RibbonTab Key="tool"
                               Title="@(currentMode == "text" ? "Text" : IsShapeMode ? "Shape" : "Draw")"
                               ContextTitle="@(currentMode == "text" ? "Text Tools" : IsShapeMode ? "Shape Tools" : "Drawing Tools")">

                        <RibbonGroup Title="@(IsShapeMode ? "Border" : "Colour")" Priority="100">
                            <RibbonContent>
                                <input type="color" class="shiny-imgeditor-color" value="@activeColor"
                                       @onchange="OnColorChanged" title="Colour" />
                            </RibbonContent>
                            @if ((IsInkMode || IsShapeMode) && ShowStrokeWidthPicker)
                            {
                                <RibbonContent>
                                    @foreach (var width in StrokeWidthPresets)
                                    {
                                        var w = width;
                                        <button class="shiny-imgeditor-weight @(IsSelectedWidth(w) ? "active" : "")"
                                                @onclick="() => SetStrokeWidthAsync(w)" title="@($"{w}px")">
                                            <span style="width:@((6 + w * 1.6).ToString(Culture))px;height:@((6 + w * 1.6).ToString(Culture))px"></span>
                                        </button>
                                    }
                                </RibbonContent>
                            }
                        </RibbonGroup>

                        @if (IsShapeMode && ShowShapeFillPicker)
                        {
                            <RibbonGroup Title="Fill" Priority="80">
                                <RibbonContent>
                                    <input type="color" class="shiny-imgeditor-color" value="@shapeFillHex"
                                           @onchange="OnFillColorChanged" title="Fill colour" />
                                    <input type="range" class="shiny-imgeditor-range" min="0" max="100" step="1"
                                           value="@FillOpacityPercent" @onchange="OnFillOpacityChanged"
                                           title="Fill opacity" aria-label="Fill opacity" />
                                </RibbonContent>
                                <RibbonToggleButton Size="RibbonItemSize.Small"
                                                    Text="@(shapeFill == null ? "No fill" : "Fill")"
                                                    Tooltip="@(shapeFill == null ? "No fill" : "Fill")"
                                                    Icon="@((shapeFill == null ? ImageEditorIcons.NoFill : ImageEditorIcons.Fill).Value)"
                                                    Checked="@(shapeFill != null)" Clicked="_ => ToggleShapeFill()" />
                            </RibbonGroup>
                        }

                        @if (currentMode == "text" && ((AllowFontSelection && AvailableFonts != null) || (AllowFontSizeSelection && AvailableFontSizes != null)))
                        {
                            <RibbonGroup Title="Font" Priority="80">
                                <RibbonContent>
                                    @if (AllowFontSelection && AvailableFonts != null)
                                    {
                                        <select class="shiny-imgeditor-select" @onchange="OnFontFamilySelected" title="Font">
                                            @foreach (var font in AvailableFonts)
                                            {
                                                <option value="@font" selected="@(font == TextFontFamily)" style="font-family:@font">@font</option>
                                            }
                                        </select>
                                    }
                                    @if (AllowFontSizeSelection && AvailableFontSizes != null)
                                    {
                                        <select class="shiny-imgeditor-select" @onchange="OnFontSizeSelected" title="Font size">
                                            @foreach (var size in AvailableFontSizes)
                                            {
                                                <option value="@size.ToString(Culture)"
                                                        selected="@(System.Math.Abs(size - TextFontSize) < 0.001)">@size pt</option>
                                            }
                                        </select>
                                    }
                                </RibbonContent>
                            </RibbonGroup>
                        }
                    </RibbonTab>
                }
                </ChildContent>
            </Ribbon>
        </div>
    }
</div>
