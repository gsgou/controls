@namespace Shiny.Blazor.Controls

<div class="shiny-row @(NoWrap ? "shiny-row--nowrap" : null) @UserClass" style="@RowStyle" @attributes="ExtraAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Overrides the parent <see cref="Grid"/>'s column count for this row.</summary>
    [Parameter] public int? Columns { get; set; }

    /// <summary>Sets both gutters for this row, in pixels.</summary>
    [Parameter] public double? Gutter { get; set; }

    /// <summary>Overrides the horizontal gutter for this row, in pixels.</summary>
    [Parameter] public double? GutterX { get; set; }

    /// <summary>Overrides the vertical gutter for this row, in pixels.</summary>
    [Parameter] public double? GutterY { get; set; }

    /// <summary>Main-axis distribution of the columns.</summary>
    [Parameter] public StackJustify Justify { get; set; } = StackJustify.Start;

    /// <summary>Cross-axis alignment of the columns. Defaults to <see cref="StackAlign.Stretch"/>.</summary>
    [Parameter] public StackAlign Align { get; set; } = StackAlign.Stretch;

    /// <summary>Keep every column on one line instead of wrapping.</summary>
    [Parameter] public bool NoWrap { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    IDictionary<string, object>? ExtraAttributes;
    string? UserClass;
    string RowStyle = string.Empty;

    protected override void OnParametersSet()
    {
        this.ExtraAttributes = LayoutAttributes.Split(this.AdditionalAttributes, out var userClass, out var userStyle);
        this.UserClass = userClass;

        var style = $"justify-content:{this.Justify.ToCss()};align-items:{this.Align.ToCss()};";

        if (this.Columns is > 0)
            style += $"--shiny-grid-cols:{LayoutAttributes.Num(this.Columns.Value)};";

        var gx = this.GutterX ?? this.Gutter;
        var gy = this.GutterY ?? this.Gutter;
        if (gx is not null)
            style += $"--shiny-grid-gutter-x:{LayoutAttributes.Px(gx.Value)};";
        if (gy is not null)
            style += $"--shiny-grid-gutter-y:{LayoutAttributes.Px(gy.Value)};";

        this.RowStyle = LayoutAttributes.Append(style, userStyle);
    }
}
