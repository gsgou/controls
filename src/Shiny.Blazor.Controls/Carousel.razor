@namespace Shiny.Blazor.Controls
@typeparam TItem

<div class="@RootClasses"
     style="@RootStyle"
     tabindex="0"
     role="region"
     aria-roledescription="carousel"
     aria-label="@(AriaLabel ?? "Carousel")"
     @onkeydown="OnKeyDown"
     @attributes="AdditionalAttributes">

    @if (Count == 0)
    {
        <div class="shiny-carousel-empty">
            @if (EmptyTemplate is not null)
            {
                @EmptyTemplate
            }
            else
            {
                <span>No items</span>
            }
        </div>
    }
    else
    {
        <div class="shiny-carousel-viewport" @ref="viewportRef">
            <div class="shiny-carousel-container" @ref="containerRef" aria-live="@(AutoPlay || AutoScroll ? "off" : "polite")">
                @for (var i = 0; i < Count; i++)
                {
                    var index = i;
                    var item = Items![index];
                    <div class="shiny-carousel-slide"
                         role="group"
                         aria-roledescription="slide"
                         aria-label="@($"{index + 1} of {Count}")"
                         @onclick="() => OnItemClicked(index)">
                        <div class="shiny-carousel-slide-tween">
                            @if (IsLoaded(index))
                            {
                                @if (ItemTemplate is not null)
                                {
                                    @ItemTemplate(item)
                                }
                                else
                                {
                                    @item?.ToString()
                                }
                            }
                            else if (PlaceholderTemplate is not null)
                            {
                                @PlaceholderTemplate
                            }
                            else
                            {
                                <div class="shiny-carousel-placeholder"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (ShowArrows)
        {
            <button type="button" class="shiny-carousel-arrow prev"
                    aria-label="Previous"
                    disabled="@(!Loop && CurrentPosition == 0)"
                    @onclick="PreviousAsync">‹</button>
            <button type="button" class="shiny-carousel-arrow next"
                    aria-label="Next"
                    disabled="@(!Loop && CurrentPosition >= SnapCount - 1)"
                    @onclick="NextAsync">›</button>
        }

        @if (ShowProgress)
        {
            <div class="shiny-carousel-progress"><div class="bar"></div></div>
        }

        <div class="shiny-carousel-footer">
            @if (ShowIndicators)
            {
                <div class="shiny-carousel-indicators" role="tablist" aria-label="Carousel position">
                    @for (var d = 0; d < SnapCount; d++)
                    {
                        var dot = d;
                        <button type="button"
                                class="shiny-carousel-dot @(dot == CurrentPosition ? "active" : "")"
                                role="tab"
                                aria-selected="@(dot == CurrentPosition)"
                                aria-label="@($"Go to {dot + 1}")"
                                @onclick="() => GoToAsync(dot)"></button>
                    }
                </div>
            }

            @if (ShowCounter)
            {
                <div class="shiny-carousel-counter">@(CurrentPosition + 1) / @SnapCount</div>
            }
        </div>

        @if (ShowThumbnails)
        {
            <div class="shiny-carousel-thumbs">
                @for (var t = 0; t < Count; t++)
                {
                    var thumb = t;
                    var active = (thumb / Math.Max(1, SlidesToScroll)) == CurrentPosition;
                    <button type="button"
                            class="shiny-carousel-thumb @(active ? "active" : "")"
                            aria-label="@($"Go to slide {thumb + 1}")"
                            @onclick="() => OnThumbClicked(thumb)">
                        @if (ThumbnailTemplate is not null)
                        {
                            @ThumbnailTemplate(Items![thumb])
                        }
                        else
                        {
                            <span>@(thumb + 1)</span>
                        }
                    </button>
                }
            </div>
        }
    }
</div>
