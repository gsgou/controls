@namespace Shiny.Blazor.Controls
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    The scrim sits OUTSIDE the bar: backdrop-filter on a frosted toolbar would make it the containing
    block for position:fixed children, so a scrim rendered inside it would only cover the bar itself.
*@
@if (AnyMenuOpen)
{
    <div class="shiny-toolbar-menu-backdrop"
         popover="manual"
         style="z-index:@(ZIndex - 1);"
         @ref="backdropEl"
         @onclick="CloseMenus"></div>
}

<div class="@RootClass" style="@RootStyle" @ref="rootEl" @onkeydown="OnKeyDown">
    <div class="shiny-toolbar-inner">
        @if (StartContent != null)
        {
            <div class="shiny-toolbar-start">@StartContent</div>
        }
        else if (!string.IsNullOrEmpty(Title))
        {
            <div class="shiny-toolbar-title">@Title</div>
        }

        @if (ChildContent != null)
        {
            <div class="shiny-toolbar-content">@ChildContent</div>
        }

        <div class="shiny-toolbar-trailing">
            @if (BarItems.Count > 0)
            {
                <div class="shiny-toolbar-items">
                    @foreach (var item in VisibleItems)
                    {
                        @ItemTemplate(item, false)
                    }

                    @if (HasOverflow)
                    {
                        <div class="shiny-toolbar-item-wrap">
                            <button type="button"
                                    class="shiny-toolbar-item shiny-toolbar-more"
                                    aria-haspopup="true"
                                    aria-expanded="@overflowOpen"
                                    aria-label="@OverflowAriaLabel"
                                    @onclick="ToggleOverflow"
                                    @onclick:stopPropagation="true">
                                <span class="shiny-toolbar-item-icon" style="@ItemStyle(null)">@((MarkupString)OverflowIcon)</span>
                                @if (ShowItemLabels && !string.IsNullOrEmpty(OverflowText))
                                {
                                    <span class="shiny-toolbar-item-label">@OverflowText</span>
                                }
                            </button>

                            @if (overflowOpen)
                            {
                                @MenuPanel(OverflowItems, 0, false)
                            }
                        </div>
                    }

                    @if (UseOverflow)
                    {
                        <div class="shiny-toolbar-measure" aria-hidden="true">
                            @foreach (var item in BarItems)
                            {
                                <div data-measure-item>@ItemTemplate(item, true)</div>
                            }
                            <div data-measure-toggle>
                                <button type="button" class="shiny-toolbar-item shiny-toolbar-more" tabindex="-1">
                                    <span class="shiny-toolbar-item-icon" style="@ItemStyle(null)">@((MarkupString)OverflowIcon)</span>
                                    @if (ShowItemLabels && !string.IsNullOrEmpty(OverflowText))
                                    {
                                        <span class="shiny-toolbar-item-label">@OverflowText</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (EndContent != null)
            {
                <div class="shiny-toolbar-end">@EndContent</div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public ToolbarDock Dock { get; set; } = ToolbarDock.Top;

    /// <summary>When true (default) the bar pins via position:sticky so page content scrolls under it.</summary>
    [Parameter] public bool Sticky { get; set; } = true;

    [Parameter] public string? Title { get; set; }
    [Parameter] public List<ToolbarItem>? Items { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? StartContent { get; set; }

    /// <summary>
    /// Arbitrary markup pinned to the trailing edge. It sits outside the overflow calculation and is never
    /// collapsed - <see cref="Items"/> given alongside it still fold into the dropdown as the bar narrows.
    /// </summary>
    [Parameter] public RenderFragment? EndContent { get; set; }

    [Parameter] public string BackgroundColor { get; set; } = "#FFFFFF";
    [Parameter] public string TextColor { get; set; } = "#1F2937";
    [Parameter] public double Height { get; set; } = 56;
    [Parameter] public double IconSize { get; set; } = 22;
    [Parameter] public bool ShowItemLabels { get; set; }

    // overflow -> hamburger dropdown
    /// <summary>When true (default) items that don't fit collapse into a dropdown menu behind the overflow button.</summary>
    [Parameter] public bool OverflowEnabled { get; set; } = true;

    /// <summary>Inline SVG/HTML for the overflow ("more") button. Defaults to a hamburger glyph.</summary>
    [Parameter] public string OverflowIcon { get; set; } = HamburgerIcon;

    /// <summary>Optional label shown under the overflow button when <see cref="ShowItemLabels"/> is on.</summary>
    [Parameter] public string? OverflowText { get; set; } = "More";

    /// <summary>Accessible label for the overflow button.</summary>
    [Parameter] public string OverflowAriaLabel { get; set; } = "More actions";

    [Parameter] public string MenuBackgroundColor { get; set; } = "#FFFFFF";
    [Parameter] public string MenuTextColor { get; set; } = "#1F2937";

    /// <summary>Chevron drawn on items that open a dropdown. Set to an empty string to drop it.</summary>
    [Parameter] public string DropdownIcon { get; set; } = ChevronDownIcon;

    // frosted glass
    [Parameter] public bool Frosted { get; set; }
    [Parameter] public double BlurRadius { get; set; } = 20;
    [Parameter] public string TintColor { get; set; } = "rgba(255, 255, 255, 0.7)";

    // chrome
    [Parameter] public bool HasShadow { get; set; } = true;
    [Parameter] public string? BorderColor { get; set; }
    [Parameter] public double BorderThickness { get; set; }
    [Parameter] public bool SafeArea { get; set; } = true;
    [Parameter] public int ZIndex { get; set; } = 100;

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }

    /// <summary>Raised for the item that was actually invoked - a bar button, or a leaf inside a dropdown.</summary>
    [Parameter] public EventCallback<ToolbarItem> ItemClicked { get; set; }

    const string HamburgerIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'><path d='M3 6h18M3 12h18M3 18h18'/></svg>";
    const string ChevronDownIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>";
    const string ChevronRightIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 6l6 6-6 6'/></svg>";

    ElementReference rootEl;
    ElementReference backdropEl;
    IJSObjectReference? module;
    DotNetObjectReference<ShinyToolbar>? selfRef;
    bool loadingModule;
    bool observerAttached;

    bool overflowOpen;

    // the chain of items whose dropdowns are currently open, outermost first. Index == menu depth, so a
    // menu at depth d is open when openChain[d] is the item it hangs off.
    readonly List<ToolbarItem> openChain = new();

    // how many items currently fit; int.MaxValue == "show everything" until JS measures
    int visibleCount = int.MaxValue;

    bool IsTop => Dock == ToolbarDock.Top;

    // separators only mean something inside a menu - one on the bar itself would just be a stray line
    List<ToolbarItem> barItems = new();

    List<ToolbarItem> BarItems => barItems;

    protected override void OnParametersSet()
        => barItems = Items?.Where(x => !x.IsSeparator).ToList() ?? new List<ToolbarItem>();

    bool UseOverflow => OverflowEnabled && BarItems.Count > 0;

    int VisibleItemCount => Math.Min(UseOverflow ? visibleCount : int.MaxValue, BarItems.Count);

    bool HasOverflow => VisibleItemCount < BarItems.Count;

    IEnumerable<ToolbarItem> VisibleItems => BarItems.Take(VisibleItemCount);

    IEnumerable<ToolbarItem> OverflowItems => BarItems.Skip(VisibleItemCount);

    bool AnyMenuOpen => overflowOpen || openChain.Count > 0;

    string RootClass
    {
        get
        {
            var c = "shiny-toolbar";
            c += IsTop ? " shiny-toolbar--top" : " shiny-toolbar--bottom";
            if (Frosted) c += " shiny-toolbar--frosted";
            if (HasShadow) c += " shiny-toolbar--shadow";
            if (ShowItemLabels) c += " shiny-toolbar--labelled";
            if (!string.IsNullOrEmpty(CssClass)) c += " " + CssClass;
            return c;
        }
    }

    string RootStyle
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.Append("position:").Append(Sticky ? "sticky" : "relative").Append(';');
            sb.Append(IsTop ? "top:0;" : "bottom:0;");
            sb.Append("z-index:").Append(ZIndex).Append(';');
            sb.Append("color:").Append(TextColor).Append(';');
            sb.Append("min-height:").Append(Height.ToInv()).Append("px;");

            if (Frosted)
            {
                sb.Append("background-color:").Append(TintColor).Append(';');
                sb.Append("backdrop-filter:blur(").Append(BlurRadius.ToInv()).Append("px);");
                sb.Append("-webkit-backdrop-filter:blur(").Append(BlurRadius.ToInv()).Append("px);");
            }
            else
            {
                sb.Append("background-color:").Append(BackgroundColor).Append(';');
            }

            if (BorderThickness > 0 && !string.IsNullOrEmpty(BorderColor))
            {
                var edge = IsTop ? "border-bottom" : "border-top";
                sb.Append(edge).Append(':').Append(BorderThickness.ToInv()).Append("px solid ").Append(BorderColor).Append(';');
            }

            if (SafeArea)
                sb.Append(IsTop ? "padding-top:env(safe-area-inset-top);" : "padding-bottom:env(safe-area-inset-bottom);");

            if (!string.IsNullOrEmpty(Style)) sb.Append(Style);
            return sb.ToString();
        }
    }

    string ItemStyle(ToolbarItem? item)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("--shiny-toolbar-icon-size:").Append(IconSize.ToInv()).Append("px;");
        if (item != null && !string.IsNullOrEmpty(item.IconColor)) sb.Append("color:").Append(item.IconColor).Append(';');
        return sb.ToString();
    }

    string MenuStyle => $"background-color:{MenuBackgroundColor};color:{MenuTextColor};";

    // measuring == the off-screen mirror row, which wants the button's width and nothing else:
    // no open dropdown, no click handlers, nothing focusable.
    RenderFragment ItemTemplate(ToolbarItem item, bool measuring) =>
        @<text>
            @if (item.HasChildren)
            {
                <div class="shiny-toolbar-item-wrap">
                    <button type="button"
                            class="shiny-toolbar-item shiny-toolbar-item--menu"
                            style="@ItemStyle(item)"
                            title="@(item.Tooltip ?? item.Text)"
                            disabled="@item.IsDisabled"
                            tabindex="@(measuring ? "-1" : null)"
                            aria-haspopup="true"
                            aria-expanded="@(!measuring && IsOpenAt(0, item))"
                            @onclick="@(_ => ToggleRootMenu(item))"
                            @onclick:stopPropagation="true">
                        @ItemBody(item)
                        @if (!string.IsNullOrEmpty(DropdownIcon))
                        {
                            <span class="shiny-toolbar-item-caret">@((MarkupString)DropdownIcon)</span>
                        }
                    </button>

                    @if (!measuring && IsOpenAt(0, item))
                    {
                        @MenuPanel(item.Children!, 1, false)
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(item.Href))
            {
                <a class="shiny-toolbar-item"
                   href="@item.Href"
                   target="@item.Target"
                   style="@ItemStyle(item)"
                   title="@(item.Tooltip ?? item.Text)"
                   tabindex="@(measuring ? "-1" : null)"
                   @onclick="@(_ => OnItemClicked(item))">
                    @ItemBody(item)
                </a>
            }
            else
            {
                <button type="button"
                        class="shiny-toolbar-item"
                        style="@ItemStyle(item)"
                        title="@(item.Tooltip ?? item.Text)"
                        disabled="@item.IsDisabled"
                        tabindex="@(measuring ? "-1" : null)"
                        @onclick="@(_ => OnItemClicked(item))"
                        @onclick:stopPropagation="true">
                    @ItemBody(item)
                </button>
            }
        </text>;

    RenderFragment ItemBody(ToolbarItem item) =>
        @<text>
            <span class="shiny-toolbar-item-icon">
                @if (!string.IsNullOrEmpty(item.Icon))
                {
                    if (IsImageUrl(item.Icon!))
                    {
                        <img src="@item.Icon" alt="" />
                    }
                    else
                    {
                        @((MarkupString)item.Icon!)
                    }
                }
            </span>
            @if (ShowItemLabels && !string.IsNullOrEmpty(item.Text))
            {
                <span class="shiny-toolbar-item-label">@item.Text</span>
            }
            @if (item.Badge != null)
            {
                <span class="shiny-toolbar-item-badge">@item.Badge</span>
            }
        </text>;

    /// <summary>One dropdown panel. <paramref name="depth"/> is its index in <c>openChain</c>.</summary>
    RenderFragment MenuPanel(IEnumerable<ToolbarItem> items, int depth, bool submenu) =>
        @*
            The panel is a manual popover so it lands in the browser's top layer: a dropdown inside a
            panel or scroller would otherwise be clipped by that ancestor's overflow. JS places it and
            falls back to plain absolute positioning where the API is missing.
        *@
        @<div class="shiny-toolbar-menu @(submenu ? "shiny-toolbar-submenu" : null)"
              role="menu"
              popover="manual"
              data-menu-depth="@depth"
              style="@MenuStyle">
            @foreach (var item in items)
            {
                if (item.IsSeparator)
                {
                    <div class="shiny-toolbar-menu-separator" role="separator"></div>
                }
                else if (item.HasChildren)
                {
                    <div class="shiny-toolbar-menu-item-wrap">
                        <button type="button"
                                class="shiny-toolbar-menu-item shiny-toolbar-menu-item--parent"
                                role="menuitem"
                                style="@ItemStyle(item)"
                                disabled="@item.IsDisabled"
                                aria-haspopup="true"
                                aria-expanded="@IsOpenAt(depth, item)"
                                @onclick="@(_ => ToggleSubmenu(item, depth))"
                                @onclick:stopPropagation="true">
                            @MenuItemBody(item)
                            <span class="shiny-toolbar-menu-item-caret">@((MarkupString)ChevronRightIcon)</span>
                        </button>

                        @if (IsOpenAt(depth, item))
                        {
                            @MenuPanel(item.Children!, depth + 1, true)
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(item.Href))
                {
                    <a class="shiny-toolbar-menu-item"
                       role="menuitem"
                       href="@item.Href"
                       target="@item.Target"
                       style="@ItemStyle(item)"
                       @onclick="@(_ => OnMenuItemClicked(item))">
                        @MenuItemBody(item)
                    </a>
                }
                else
                {
                    <button type="button"
                            class="shiny-toolbar-menu-item"
                            role="menuitem"
                            style="@ItemStyle(item)"
                            disabled="@item.IsDisabled"
                            @onclick="@(_ => OnMenuItemClicked(item))"
                            @onclick:stopPropagation="true">
                        @MenuItemBody(item)
                    </button>
                }
            }
        </div>;

    RenderFragment MenuItemBody(ToolbarItem item) =>
        @<text>
            <span class="shiny-toolbar-item-icon">
                @if (!string.IsNullOrEmpty(item.Icon))
                {
                    if (IsImageUrl(item.Icon!))
                    {
                        <img src="@item.Icon" alt="" />
                    }
                    else
                    {
                        @((MarkupString)item.Icon!)
                    }
                }
            </span>
            <span class="shiny-toolbar-menu-item-text">@(item.Text ?? string.Empty)</span>
            @if (item.Badge != null)
            {
                <span class="shiny-toolbar-menu-item-badge">@item.Badge</span>
            }
        </text>;

    bool IsOpenAt(int depth, ToolbarItem item) => openChain.Count > depth && ReferenceEquals(openChain[depth], item);

    void ToggleOverflow()
    {
        var wasOpen = overflowOpen;
        CloseMenus();
        overflowOpen = !wasOpen;
    }

    void ToggleRootMenu(ToolbarItem item)
    {
        if (item.IsDisabled) return;

        var wasOpen = IsOpenAt(0, item);
        CloseMenus();
        if (!wasOpen)
            openChain.Add(item);
    }

    void ToggleSubmenu(ToolbarItem item, int depth)
    {
        if (item.IsDisabled) return;

        var wasOpen = IsOpenAt(depth, item);

        // anything deeper than this menu belongs to a sibling that is now closing
        if (openChain.Count > depth)
            openChain.RemoveRange(depth, openChain.Count - depth);

        if (!wasOpen)
            openChain.Add(item);
    }

    void CloseMenus()
    {
        overflowOpen = false;
        openChain.Clear();
    }

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && AnyMenuOpen)
            CloseMenus();
    }

    async Task OnItemClicked(ToolbarItem item)
    {
        if (item.IsDisabled) return;
        CloseMenus();
        if (ItemClicked.HasDelegate)
            await ItemClicked.InvokeAsync(item);
    }

    async Task OnMenuItemClicked(ToolbarItem item)
    {
        if (item.IsDisabled) return;
        CloseMenus();
        if (ItemClicked.HasDelegate)
            await ItemClicked.InvokeAsync(item);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // the module is loaded on demand - a bar with no items and no dropdowns never needs JS at all,
        // and one that gets its items later still picks it up
        if (module == null && !loadingModule && (UseOverflow || AnyMenuOpen))
        {
            loadingModule = true;
            selfRef ??= DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Shiny.Blazor.Controls/toolbar.js");
            loadingModule = false;
        }

        if (module == null)
            return;

        if (UseOverflow && !observerAttached)
        {
            observerAttached = true;
            await module.InvokeVoidAsync("init", rootEl, selfRef);
        }
        else if (UseOverflow)
        {
            await module.InvokeVoidAsync("remeasure", rootEl);
        }

        // open dropdowns are raised into the top layer and placed against their button
        if (AnyMenuOpen)
            await module.InvokeVoidAsync("placeMenus", rootEl, backdropEl);
    }

    [JSInvokable]
    public Task SetVisibleCount(int count)
    {
        if (count != visibleCount)
        {
            visibleCount = count;
            // items just moved between the bar and the menu - whatever was open no longer points anywhere sane
            CloseMenus();
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("dispose", rootEl);
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // circuit already gone — nothing to clean up
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // module never finished importing
        }
        selfRef?.Dispose();
    }

    static bool IsImageUrl(string s)
        => s.StartsWith("http", StringComparison.OrdinalIgnoreCase)
           || s.StartsWith("/")
           || s.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
           || s.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
           || s.EndsWith(".svg", StringComparison.OrdinalIgnoreCase)
           || s.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);
}
