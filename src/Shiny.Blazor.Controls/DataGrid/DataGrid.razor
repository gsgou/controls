@namespace Shiny.Blazor.Controls
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@using Microsoft.AspNetCore.Components.Web.Virtualization

<CascadingValue Value="this" IsFixed="true">
    @Columns
    @{
        // Resolve the pinned blocks once per render - every frozen helper below is then a lookup.
        RefreshFrozenLayout();
    }

    @* pointerleave on the root (not the scroller): a drag that crosses the scroller's edge is still a
       drag, but a pointer that has left the whole grid is never coming back to finish one. *@
    <div @ref="rootRef" class="@RootCssClass" style="@RootStyle"
         @onpointerleave="OnResizeEndAsync" @attributes="AdditionalAttributes">
        @if (ToolbarContent is not null || FilterMode == DataGridFilterMode.Toolbar)
        {
            <div class="shiny-dg-toolbar">
                @if (FilterMode == DataGridFilterMode.Toolbar)
                {
                    <input class="shiny-dg-quickfilter" type="search" placeholder="Search…"
                           value="@QuickSearch" @oninput="e => SetQuickSearchAsync(e.Value?.ToString())" />
                }
                @ToolbarContent
            </div>
        }

        @if (Loading)
        {
            <div class="shiny-dg-loading">
                @if (LoadingContent is not null)
                {
                    @LoadingContent
                }
                else
                {
                    <div class="shiny-dg-spinner"></div>
                }
            </div>
        }

        <div class="shiny-dg-scroll" @onpointermove="OnResizeMove"
             @onpointerup="OnResizeEndAsync" @onpointercancel="OnResizeEndAsync">
            <table class="shiny-dg-table">
                @if (ShowColumnHeaders)
                {
                    <thead>
                        <tr>
                            @if (HasExpanderColumn)
                            {
                                <th class="shiny-dg-expandcol@(LeadFrozenCssClass())"
                                    style="@LeadFrozenOffsetStyle(0)" data-dg-frozen="@LeadFrozenAttr()"></th>
                            }
                            @if (HasMultiSelect)
                            {
                                <th class="shiny-dg-checkcol@(LeadFrozenCssClass())"
                                    style="@LeadFrozenOffsetStyle(CheckColumnIndex)" data-dg-frozen="@LeadFrozenAttr()">
                                    <input type="checkbox" checked="@AllSelected"
                                           @onchange="e => ToggleSelectAllAsync(e.Value is true)" />
                                </th>
                            }
                            @foreach (var col in VisibleColumns)
                            {
                                var sortable = EffectiveSortable(col);
                                var sort = GetSortDefinition(col);
                                var badge = SortOrderBadge(col);
                                <th class="@HeaderCssClass(col, sortable)"
                                    style="@ColumnWidthStyle(col)"
                                    data-dg-col="@col.Id"
                                    data-dg-frozen="@FrozenAttr(col)"
                                    draggable="@(CanReorder ? "true" : "false")"
                                    @ondragstart="() => OnColumnDragStart(col)"
                                    @ondragover:preventDefault="true"
                                    @ondragover="() => OnColumnDragOver(col)"
                                    @ondragend="OnColumnDragEnd"
                                    @ondrop="() => OnColumnDropAsync(col)"
                                    @onclick="() => OnHeaderClickAsync(col, sortable)">
                                    @if (CanResize(col))
                                    {
                                        <span class="shiny-dg-resize-handle" title="Resize @col.HeaderText"
                                              @onclick:stopPropagation="true"
                                              @onpointerdown:stopPropagation="true"
                                              @onpointerdown="e => OnResizeStartAsync(col, e)"></span>
                                    }
                                    <span class="shiny-dg-header-inner">
                                        @if (col.HeaderTemplate is not null)
                                        {
                                            @col.HeaderTemplate
                                        }
                                        else
                                        {
                                            <span class="shiny-dg-header-text">@col.HeaderText</span>
                                        }
                                        @if (sortable && sort is not null)
                                        {
                                            <span class="shiny-dg-sort-icon">@(sort.Direction == DataGridSortDirection.Ascending ? "▲" : "▼")</span>
                                            @if (badge > 0)
                                            {
                                                <span class="shiny-dg-sort-badge">@badge</span>
                                            }
                                        }
                                        @if (EffectiveGroupable(col))
                                        {
                                            <span class="shiny-dg-group-icon @(IsGroupedBy(col) ? "shiny-dg-group-active" : "")"
                                                  @onclick:stopPropagation="true" @onclick="() => ToggleGroupBy(col)"
                                                  title="Group by @col.HeaderText">⊞</span>
                                        }
                                        @if (FilterMode == DataGridFilterMode.Menu && EffectiveFilterable(col))
                                        {
                                            <span class="shiny-dg-filter-icon @(HasActiveFilter(col) ? "shiny-dg-filter-active" : "")"
                                                  @onclick:stopPropagation="true" @onclick="() => ToggleFilterMenu(col)">▾</span>
                                            @if (IsFilterMenuOpen(col))
                                            {
                                                var def = GetOrCreateFilter(col);
                                                var type = col.GetDataType();
                                                <div class="shiny-dg-filter-menu" @onclick:stopPropagation="true">
                                                    <select @onchange="e => def.Operator = Enum.Parse<DataGridFilterOperator>(e.Value!.ToString()!)">
                                                        @foreach (var op in OperatorsFor(type))
                                                        {
                                                            <option value="@op" selected="@(op == def.Operator)">@OperatorLabel(op)</option>
                                                        }
                                                    </select>
                                                    <input type="text" value="@(def.Value?.ToString())"
                                                           @oninput="e => def.Value = e.Value?.ToString()" />
                                                    <div class="shiny-dg-filter-actions">
                                                        <button type="button" @onclick="() => ApplyColumnFilterAsync(col, def.Operator, def.Value)">Apply</button>
                                                        <button type="button" @onclick="() => ClearColumnFilterAsync(col)">Clear</button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </span>
                                </th>
                            }
                        </tr>
                        @if (FilterMode == DataGridFilterMode.Row)
                        {
                            <tr class="shiny-dg-filter-row">
                                @if (HasExpanderColumn)
                                {
                                    <th class="shiny-dg-expandcol@(LeadFrozenCssClass())"
                                        style="@LeadFrozenOffsetStyle(0)" data-dg-frozen="@LeadFrozenAttr()"></th>
                                }
                                @if (HasMultiSelect)
                                {
                                    <th class="@LeadFrozenCssClass()" style="@LeadFrozenOffsetStyle(CheckColumnIndex)"
                                        data-dg-frozen="@LeadFrozenAttr()"></th>
                                }
                                @foreach (var col in VisibleColumns)
                                {
                                    <th class="@FrozenCssClass(col)" style="@ColumnWidthStyle(col)"
                                        data-dg-frozen="@FrozenAttr(col)">
                                        @if (EffectiveFilterable(col))
                                        {
                                            var def = GetOrCreateFilter(col);
                                            <input type="text" placeholder="Filter" value="@(def.Value?.ToString())"
                                                   @oninput="e => ApplyColumnFilterAsync(col, def.Operator, string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())" />
                                        }
                                    </th>
                                }
                            </tr>
                        }
                    </thead>
                }

                <tbody>
                    @{
                        var treeColumn = TreeEnabled ? VisibleColumns.FirstOrDefault() : null;

                        RenderFragment<RowNode> rowFragment = node =>
                            @<tr class="@RowCssClass(node.Item)" @onclick="() => RowClickedAsync(node.Item)">
                                @{ var rowItem = node.Item; }
                                @if (HasExpanderColumn)
                                {
                                    <td class="shiny-dg-expandcol@(LeadFrozenCssClass())"
                                        style="@LeadFrozenOffsetStyle(0)" data-dg-frozen="@LeadFrozenAttr()"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OnExpanderClickAsync(rowItem)">
                                        @if (IsRowDetailLoading(rowItem))
                                        {
                                            @* The caret is the button, so the progress belongs on it. *@
                                            <span class="shiny-dg-busy" role="progressbar" aria-label="Loading"></span>
                                        }
                                        else if (CanShowDetail(rowItem))
                                        {
                                            <span class="shiny-dg-expander">@(IsRowExpanded(rowItem) ? "▾" : "▸")</span>
                                        }
                                    </td>
                                }
                                @if (HasMultiSelect)
                                {
                                    <td class="shiny-dg-checkcol@(LeadFrozenCssClass())"
                                        style="@LeadFrozenOffsetStyle(CheckColumnIndex)" data-dg-frozen="@LeadFrozenAttr()"
                                        @onclick:stopPropagation="true">
                                        <input type="checkbox" checked="@IsSelected(rowItem)"
                                               @onchange="() => ToggleRowAsync(rowItem)" />
                                    </td>
                                }
                                @{ var rowColumns = VisibleColumns; }
                                @for (var ci = 0; ci < rowColumns.Count; ci++)
                                {
                                    var col = rowColumns[ci];
                                    var editingThisCell = IsEditingCell(rowItem, col);
                                    var editingFormCell = EditMode == DataGridEditMode.Form && IsEditingRow(rowItem) && EffectiveEditable(col);
                                    var cellStyle = ResolveCellStyle(col, rowItem, ci == 0, ci == rowColumns.Count - 1, node.IsFirst, node.IsLast);
                                    <td class="@CellCssClass(col, cellStyle)"
                                        style="@CellInlineStyle(col, cellStyle)"
                                        data-dg-frozen="@FrozenAttr(col)"
                                        @onclick="() => OnCellClickAsync(rowItem, col)"
                                        @onclick:stopPropagation="@(EditMode == DataGridEditMode.Cell && EffectiveEditable(col))">
                                        @if (col == treeColumn)
                                        {
                                            <span class="shiny-dg-tree-indent" style="width:@(node.Level * TreeIndentSize)px"></span>
                                            <span class="shiny-dg-tree-caret@(node.HasChildren ? "" : " shiny-dg-tree-leaf")"
                                                  @onclick:stopPropagation="true"
                                                  @onclick="() => OnExpanderClickAsync(rowItem)">
                                                @if (node.IsLoading)
                                                {
                                                    <span class="shiny-dg-busy" role="progressbar" aria-label="Loading"></span>
                                                }
                                                else
                                                {
                                                    @node.CaretGlyph
                                                }
                                            </span>
                                        }
                                        @if (editingThisCell || editingFormCell)
                                        {
                                            @if (col.EditTemplate is not null)
                                            {
                                                @col.EditTemplate(CreateCellContext(rowItem))
                                            }
                                            else if (col.GetDataType() == typeof(bool))
                                            {
                                                <input type="checkbox" checked="@(GetEditValue(col) is true)"
                                                       @onchange="e => SetEditValue(col, e.Value)" />
                                            }
                                            else
                                            {
                                                <input class="shiny-dg-editor" value="@(GetEditValue(col)?.ToString())"
                                                       @oninput="e => SetEditValue(col, e.Value?.ToString())"
                                                       @onblur="OnEditorBlurAsync"
                                                       @onkeydown="EditorKeyDownAsync" />
                                            }
                                        }
                                        else if (col.CellTemplate is not null)
                                        {
                                            @col.CellTemplate(CreateCellContext(rowItem))
                                        }
                                        else
                                        {
                                            @col.GetText(rowItem)
                                        }
                                    </td>
                                }
                            </tr>;

                        RenderFragment<RowNode> rowWithEdit = node =>
                            @<text>
                                @rowFragment(node)
                                @if (EditMode == DataGridEditMode.Form && IsEditingRow(node.Item))
                                {
                                    <tr class="shiny-dg-edit-actions">
                                        <td colspan="@ColSpan">
                                            <button type="button" class="shiny-dg-edit-save" @onclick="CommitEditAsync">Save</button>
                                            <button type="button" class="shiny-dg-edit-cancel" @onclick="CancelEditAsync">Cancel</button>
                                        </td>
                                    </tr>
                                }
                                @if (RowDetailTemplate is not null && CanShowDetail(node.Item) && IsRowExpanded(node.Item))
                                {
                                    <tr class="shiny-dg-detail">
                                        <td colspan="@ColSpan">
                                            @* Sticky + fit-content keeps the breakdown at the leading edge while the
                                               columns scroll sideways underneath it. *@
                                            <div class="shiny-dg-detail-inner">
                                                @if (IsRowDetailLoading(node.Item))
                                                {
                                                    @* The loaded template is never rendered mid-load, so it can assume
                                                       its data arrived. *@
                                                    @if (RowDetailLoadingTemplate is not null)
                                                    {
                                                        @RowDetailLoadingTemplate(node.Item)
                                                    }
                                                    else
                                                    {
                                                        <span class="shiny-dg-busy shiny-dg-busy-lg" role="progressbar" aria-label="Loading"></span>
                                                    }
                                                }
                                                else
                                                {
                                                    @RowDetailTemplate(node.Item)
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </text>;
                    }

                    @if (IsGrouped)
                    {
                        var gcol = GroupColumn!;
                        @foreach (var group in GetGroups())
                        {
                            var collapsed = IsGroupCollapsed(group.Key);
                            <tr class="shiny-dg-group-header" @onclick="() => ToggleGroupCollapse(group.Key)">
                                <td colspan="@ColSpan">
                                    <span class="shiny-dg-group-caret">@(collapsed ? "▸" : "▾")</span>
                                    <strong>@gcol.HeaderText:</strong> @gcol.FormatValue(group.Key)
                                    <span class="shiny-dg-group-count">(@group.Items.Count)</span>
                                </td>
                            </tr>
                            @if (!collapsed)
                            {
                                @foreach (var node in Flatten(group.Items))
                                {
                                    @rowWithEdit(node)
                                }
                                @if (HasFooter)
                                {
                                    <tr class="shiny-dg-group-footer">
                                        @if (HasExpanderColumn)
                                        {
                                            <td class="shiny-dg-expandcol@(LeadFrozenCssClass())"
                                                style="@LeadFrozenOffsetStyle(0)" data-dg-frozen="@LeadFrozenAttr()"></td>
                                        }
                                        @if (HasMultiSelect)
                                        {
                                            <td class="shiny-dg-checkcol@(LeadFrozenCssClass())"
                                                style="@LeadFrozenOffsetStyle(CheckColumnIndex)" data-dg-frozen="@LeadFrozenAttr()"></td>
                                        }
                                        @foreach (var c in VisibleColumns)
                                        {
                                            <td class="@FooterCellCssClass(c)"
                                                style="@ColumnWidthStyle(c)" data-dg-frozen="@FrozenAttr(c)">@GroupAggregateText(c, group.Items)</td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    }
                    else
                    {
                        var items = GetRenderedRows();
                        @if (items.Count == 0 && !Loading)
                        {
                            <tr class="shiny-dg-norecords">
                                <td colspan="@ColSpan">
                                    @if (NoRecordsContent is not null)
                                    {
                                        @NoRecordsContent
                                    }
                                    else
                                    {
                                        @NoRecordsText
                                    }
                                </td>
                            </tr>
                        }
                        else if (CanVirtualize)
                        {
                            <Virtualize Items="@items.ToList()" Context="vnode">
                                @rowWithEdit(vnode)
                            </Virtualize>
                        }
                        else
                        {
                            @foreach (var node in items)
                            {
                                @rowWithEdit(node)
                            }
                        }
                    }
                </tbody>

                @if (HasFooter)
                {
                    <tfoot>
                        <tr>
                            @if (HasExpanderColumn)
                            {
                                <td class="shiny-dg-expandcol@(LeadFrozenCssClass())"
                                    style="@LeadFrozenOffsetStyle(0)" data-dg-frozen="@LeadFrozenAttr()"></td>
                            }
                            @if (HasMultiSelect)
                            {
                                <td class="shiny-dg-checkcol@(LeadFrozenCssClass())"
                                    style="@LeadFrozenOffsetStyle(CheckColumnIndex)" data-dg-frozen="@LeadFrozenAttr()"></td>
                            }
                            @foreach (var col in VisibleColumns)
                            {
                                <td class="@FooterCellCssClass(col)"
                                    style="@ColumnWidthStyle(col)" data-dg-frozen="@FrozenAttr(col)">
                                    @if (col.FooterTemplate is not null)
                                    {
                                        @col.FooterTemplate
                                    }
                                    else if (col.Aggregate is not null)
                                    {
                                        @ComputeAggregateText(col)
                                    }
                                </td>
                            }
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        @if (PagerContent is not null)
        {
            <div class="shiny-dg-pager-host">@PagerContent</div>
        }
    </div>
</CascadingValue>
