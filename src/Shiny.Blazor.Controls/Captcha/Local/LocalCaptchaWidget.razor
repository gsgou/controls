@namespace Shiny.Blazor.Controls.Captchas
@implements ICaptchaWidget
@implements IAsyncDisposable

<div class="shiny-captcha-local @ThemeClass @(solved ? "is-solved" : null) @(shake ? "is-wrong" : null)">

    <div class="shiny-captcha-challenge">
        @if (Options.Mode == LocalCaptchaMode.Text)
        {
            <canvas @ref="canvasEl"
                    class="shiny-captcha-canvas"
                    width="@Options.Width"
                    height="@Options.Height"
                    style="width:@(Options.Width)px;height:@(Options.Height)px;"
                    role="img"
                    aria-label="Verification image. Use the refresh button if you cannot read it."></canvas>
        }
        else
        {
            @* Math mode is deliberately real text: a screen reader can read it, which is the whole
               point of offering it as an alternative to the drawn characters. *@
            <div class="shiny-captcha-math" role="img" aria-label="@($"What is {question}?")">@question</div>
        }

        <button type="button"
                class="shiny-captcha-refresh"
                title="@Options.RefreshText"
                aria-label="@Options.RefreshText"
                disabled="@solved"
                @onclick="OnRefreshAsync">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z" fill="currentColor" />
            </svg>
        </button>
    </div>

    <div class="shiny-captcha-answer">
        <input type="text"
               class="shiny-captcha-input"
               value="@typed"
               placeholder="@Options.PlaceholderText"
               inputmode="@(Options.Mode == LocalCaptchaMode.Math ? "numeric" : "text")"
               autocomplete="off"
               autocorrect="off"
               spellcheck="false"
               aria-label="@PromptText"
               aria-invalid="@(shake ? "true" : "false")"
               readonly="@solved"
               @oninput="OnTypedAsync"
               @onkeydown="OnKeyDownAsync" />

        @if (solved)
        {
            <span class="shiny-captcha-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18">
                    <path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        }
    </div>

    <div class="shiny-captcha-message" role="status" aria-live="polite">
        @if (shake)
        {
            <span class="shiny-captcha-error">@Options.IncorrectText</span>
        }
        else if (!solved)
        {
            <span>@PromptText</span>
        }
    </div>
</div>
