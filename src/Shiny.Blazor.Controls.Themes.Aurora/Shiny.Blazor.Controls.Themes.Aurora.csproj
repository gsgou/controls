<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Blazor.Controls.Themes.Aurora</RootNamespace>
        <Description>Aurora theme pack for Shiny.Blazor.Controls — a vivid violet/cyan palette where depth is expressed as a coloured glow rather than a shadow. Link _content/Shiny.Blazor.Controls.Themes.Aurora/css/shiny-theme-aurora.css after the core theme.</Description>
        <PackageTags>blazor shiny controls theme aurora glow</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

</Project>
