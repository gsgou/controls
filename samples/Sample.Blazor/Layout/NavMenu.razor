@namespace Sample.Blazor.Layout
@using Sample.Blazor

@* The brand block lives in the AppLayoutPanel's HeaderContent so it stays pinned — this is just
   the scrolling link list, rendered from the shared Catalog so it can never drift from the
   home page. *@
<nav>
    <div class="nav-section">GET STARTED</div>
    @foreach (var item in Catalog.GettingStarted)
    {
        <NavLink class="nav-link" href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
            <span class="nav-icon" style="color:#A78BFA;">@item.Icon</span> @item.Label
        </NavLink>
    }

    @foreach (var section in Catalog.Sections)
    {
        <div class="nav-section">@section.Title.ToUpperInvariant()</div>
        @foreach (var item in section.Items)
        {
            <NavLink class="nav-link" href="@item.Href">
                <span class="nav-icon" style="color:@section.Color;">@item.Icon</span> @item.Label
            </NavLink>
        }
    }
</nav>
