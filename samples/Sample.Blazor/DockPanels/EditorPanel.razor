<pre style="margin:0;padding:12px;font-family:ui-monospace,monospace;font-size:12px;line-height:1.7;color:#1f2937;"><span style="color:#7c3aed;">var</span> builder = WebAssemblyHostBuilder.CreateDefault(args);

builder.Services.AddShinyDocking();
builder.Services.AddDockPanel&lt;ExplorerPanel&gt;(<span style="color:#16a34a;">"explorer"</span>, <span style="color:#16a34a;">"Explorer"</span>);
builder.Services.AddDockPanel&lt;OutputPanel&gt;(<span style="color:#16a34a;">"output"</span>, <span style="color:#16a34a;">"Output"</span>);

<span style="color:#9ca3af;">// counter below proves keep-alive: switch tabs and it keeps its value</span>
</pre>
<div style="padding:0 12px 12px;display:flex;gap:10px;align-items:center;font-size:12px;">
    <button style="padding:4px 10px;" @onclick="() => count++">Click me</button>
    <span>Clicks: <strong id="editor-counter">@count</strong></span>
</div>

@code {
    int count;
}
