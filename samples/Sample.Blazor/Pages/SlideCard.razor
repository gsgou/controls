<div class="slidecard@(Fill ? " fill" : "")"
     style="background:linear-gradient(135deg,@Slide.Color,@Slide.GradientEnd)">
    <span class="ico">@Slide.Icon</span>
    <span class="title">@Slide.Title</span>
</div>

<style>
    .slidecard { width:100%; height:100%; display:flex; flex-direction:column;
                 align-items:center; justify-content:center; color:#fff; border-radius:12px; }
    .slidecard.fill { border-radius:0; }
    .slidecard .ico { font-size:40px; }
    .slidecard .title { font-size:18px; font-weight:600; margin-top:6px; }
</style>

@code {
    [Parameter] public DemoSlide Slide { get; set; } = default!;
    [Parameter] public bool Fill { get; set; }
}
