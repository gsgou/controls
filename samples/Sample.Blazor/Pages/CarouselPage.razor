@page "/carousel-advanced"

<PageTitle>Carousel</PageTitle>

<h1>Carousel</h1>
<p>Auto-play, lazy item templates, animated transitions, and scroll-driven scaling.</p>

<section class="demo-section">
    <h2>Auto-play + scroll scaling (Snap)</h2>
    <Carousel TItem="Slide" Items="@slides"
              Transition="CarouselTransition.Snap"
              AutoPlay="true" AutoPlayInterval="3000" PauseOnHover="true"
              EnableScaling="true" FocusedItemScale="1.0" UnfocusedItemScale="0.8"
              ItemWidth="300" ItemHeight="190" PeekAmount="56"
              ShowAutoPlayProgress="true"
              CurrentPosition="@pos" CurrentPositionChanged="@(p => pos = p)">
        <ItemTemplate Context="s">
            <div class="slide" style="background:linear-gradient(135deg,@s.Color,@s.GradientEnd)">
                <span class="ico">@s.Icon</span>
                <span class="title">@s.Title</span>
            </div>
        </ItemTemplate>
    </Carousel>
    <p style="text-align:center;margin-top:8px;">Position: <strong>@pos</strong></p>
</section>

<section class="demo-section">
    <h2>Crossfade</h2>
    <Carousel TItem="Slide" Items="@slides" Transition="CarouselTransition.Fade"
              AutoPlay="true" AutoPlayInterval="2500" ItemHeight="200">
        <ItemTemplate Context="s">
            <div class="slide fill" style="background:linear-gradient(135deg,@s.Color,@s.GradientEnd)">
                <span class="ico">@s.Icon</span>
                <span class="title">@s.Title</span>
            </div>
        </ItemTemplate>
    </Carousel>
</section>

<section class="demo-section">
    <h2>Slide + lazy templates</h2>
    <Carousel TItem="Slide" Items="@slides" Transition="CarouselTransition.Slide"
              ItemHeight="200" LazyLoad="true" LazyLoadBuffer="1">
        <ItemTemplate Context="s">
            <div class="slide fill" style="background:linear-gradient(135deg,@s.Color,@s.GradientEnd)">
                <span class="ico">@s.Icon</span>
                <span class="title">@s.Title</span>
            </div>
        </ItemTemplate>
        <PlaceholderTemplate>
            <div class="slide fill" style="background:#e5e7eb;color:#9ca3af">Loading…</div>
        </PlaceholderTemplate>
    </Carousel>
</section>

<section class="demo-section">
    <h2>Zoom (Scale)</h2>
    <Carousel TItem="Slide" Items="@slides" Transition="CarouselTransition.Scale"
              AutoPlay="true" AutoPlayInterval="2800" ItemHeight="200" ShowArrows="true">
        <ItemTemplate Context="s">
            <div class="slide fill" style="background:linear-gradient(135deg,@s.Color,@s.GradientEnd)">
                <span class="ico">@s.Icon</span>
                <span class="title">@s.Title</span>
            </div>
        </ItemTemplate>
    </Carousel>
</section>

<style>
    .slide { width:100%; height:100%; display:flex; flex-direction:column;
             align-items:center; justify-content:center; color:#fff; border-radius:12px; }
    .slide.fill { border-radius:0; }
    .slide .ico { font-size:40px; }
    .slide .title { font-size:18px; font-weight:600; margin-top:6px; }
</style>

@code {
    int pos;

    List<Slide> slides = new()
    {
        new("Mountains", "#2D3748", "#4A5568", "🏔️"),
        new("Ocean", "#2B6CB0", "#63B3ED", "🌊"),
        new("Forest", "#276749", "#68D391", "🌲"),
        new("Desert", "#C05621", "#F6AD55", "🏜️"),
        new("City", "#553C9A", "#B794F4", "🌃"),
        new("Aurora", "#1A365D", "#4FD1C5", "🌌"),
    };

    record Slide(string Title, string Color, string GradientEnd, string Icon);
}
