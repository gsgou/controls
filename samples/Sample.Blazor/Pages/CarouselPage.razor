@page "/carousel-advanced"

<PageTitle>Carousel</PageTitle>

<h1>Carousel</h1>
<p>A transform-based drag engine — click-drag on desktop, flick on touch — with alignment,
   slides-per-view, scroll-linked effects, looping, autoplay, and more.</p>

<div class="carousel-gallery">

    @* ---------- Basics ---------- *@
    <article class="ex">
        <h3>Default</h3>
        <p>Single slide, centre aligned, draggable.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="1" ItemHeight="200"
                  ShowArrows="true" ShowIndicators="true">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Loop</h3>
        <p>Seamless wrap-around in both directions.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="1" ItemHeight="200" Loop="true">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Slides per view</h3>
        <p>Three slides visible at once.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="3" ItemHeight="160" Align="CarouselAlign.Start">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Slides to scroll</h3>
        <p>Two visible, advances two at a time.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="2" SlidesToScroll="2" ItemHeight="160">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Align: start</h3>
        <p>Fixed-width slides anchored to the leading edge.</p>
        <Carousel TItem="DemoSlide" Items="@slides" ItemWidth="220" ItemHeight="160" Align="CarouselAlign.Start">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Drag free</h3>
        <p>Momentum scrolling with no snap.</p>
        <Carousel TItem="DemoSlide" Items="@slides" ItemWidth="200" ItemHeight="160"
                  DragFree="true" Align="CarouselAlign.Start" ShowIndicators="false">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Variable widths</h3>
        <p>Each slide sizes to its own content.</p>
        <Carousel TItem="DemoSlide" Items="@slides" VariableWidths="true" ItemHeight="160"
                  Align="CarouselAlign.Start" ShowIndicators="false">
            <ItemTemplate Context="s">
                <div class="slide" style="width:@(120 + s.Title.Length * 14)px;background:linear-gradient(135deg,@s.Color,@s.GradientEnd)">
                    <span class="ico">@s.Icon</span><span class="title">@s.Title</span>
                </div>
            </ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Y-axis</h3>
        <p>Vertical drag and snapping.</p>
        <Carousel TItem="DemoSlide" Items="@slides" Orientation="CarouselOrientation.Vertical"
                  ViewportHeight="220" ItemHeight="120">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Right to left</h3>
        <p>Mirrored layout and drag direction.</p>
        <Carousel TItem="DemoSlide" Items="@slides" Rtl="true" SlidesPerView="2" ItemHeight="160">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    @* ---------- Auto motion ---------- *@
    <article class="ex">
        <h3>Autoplay</h3>
        <p>Advances every 3s, pauses on hover, with a progress bar.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="1" ItemHeight="200"
                  AutoPlay="true" AutoPlayInterval="3000" ShowProgress="true">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Auto scroll</h3>
        <p>Continuous marquee, pauses on hover.</p>
        <Carousel TItem="DemoSlide" Items="@slides" ItemWidth="200" ItemHeight="160"
                  AutoScroll="true" AutoScrollSpeed="50" Align="CarouselAlign.Start"
                  ShowArrows="false" ShowIndicators="false">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    @* ---------- Effects ---------- *@
    <article class="ex">
        <h3>Scale</h3>
        <p>Slides shrink as they leave the centre.</p>
        <Carousel TItem="DemoSlide" Items="@slides" ItemWidth="240" ItemHeight="190"
                  Effect="CarouselEffect.Scale" FocusedItemScale="1" UnfocusedItemScale="0.72">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Opacity</h3>
        <p>Off-centre slides fade out.</p>
        <Carousel TItem="DemoSlide" Items="@slides" ItemWidth="240" ItemHeight="190"
                  Effect="CarouselEffect.Opacity" MinOpacity="0.15">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Parallax</h3>
        <p>Content drifts inside each slide.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="1" ItemHeight="200"
                  Effect="CarouselEffect.Parallax" ParallaxFactor="0.5">
            <ItemTemplate Context="s"><SlideCard Slide="s" Fill="true" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex">
        <h3>Fade</h3>
        <p>Stacked slides crossfade.</p>
        <Carousel TItem="DemoSlide" Items="@slides" ItemHeight="200" Effect="CarouselEffect.Fade"
                  AutoPlay="true" AutoPlayInterval="2500">
            <ItemTemplate Context="s"><SlideCard Slide="s" Fill="true" /></ItemTemplate>
        </Carousel>
    </article>

    @* ---------- Chrome ---------- *@
    <article class="ex">
        <h3>Counter + progress</h3>
        <p>Numeric readout and scroll-linked bar.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="1" ItemHeight="200"
                  ShowCounter="true" ShowProgress="true" ShowIndicators="false">
            <ItemTemplate Context="s"><SlideCard Slide="s" /></ItemTemplate>
        </Carousel>
    </article>

    <article class="ex wide">
        <h3>Thumbnails</h3>
        <p>Navigate via a thumbnail strip.</p>
        <Carousel TItem="DemoSlide" Items="@slides" SlidesPerView="1" ItemHeight="220"
                  ShowThumbnails="true" ShowIndicators="false">
            <ItemTemplate Context="s"><SlideCard Slide="s" Fill="true" /></ItemTemplate>
            <ThumbnailTemplate Context="s">
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,@s.Color,@s.GradientEnd)">@s.Icon</div>
            </ThumbnailTemplate>
        </Carousel>
    </article>

</div>

<style>
    .carousel-gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); gap:24px; }
    .ex { background:var(--shiny-color-surface,#fff); border:1px solid rgba(0,0,0,.08); border-radius:14px; padding:16px; }
    .ex.wide { grid-column:1 / -1; }
    .ex h3 { margin:0 0 2px; font-size:16px; }
    .ex p { margin:0 0 12px; font-size:13px; color:#6b7280; }
    .slide { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center;
             color:#fff; border-radius:12px; }
    .slide .ico { font-size:40px; }
    .slide .title { font-size:18px; font-weight:600; margin-top:6px; }
</style>

@code {
    List<DemoSlide> slides = new()
    {
        new("Mountains", "#2D3748", "#4A5568", "🏔️"),
        new("Ocean", "#2B6CB0", "#63B3ED", "🌊"),
        new("Forest", "#276749", "#68D391", "🌲"),
        new("Desert", "#C05621", "#F6AD55", "🏜️"),
        new("City", "#553C9A", "#B794F4", "🌃"),
        new("Aurora", "#1A365D", "#4FD1C5", "🌌"),
    };
}
