@page "/agenda"

<PageTitle>Scheduler · Agenda</PageTitle>

<h1>Scheduler — Agenda View</h1>

<div class="demo-section" style="height:680px;display:flex;flex-direction:column;">
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
        <button class="toggle toggle--purple" @onclick="ToggleDatePickerMode">@DatePickerToggleText</button>
        <button class="toggle toggle--slate" @onclick="ToggleTimezones">@TimezoneToggleText</button>
        <button class="toggle toggle--blue" @onclick="ToggleDays">@DaysToggleText</button>
    </div>

    <SchedulerAgendaView Provider="provider"
                         @bind-SelectedDate="selectedDate"
                         DaysToShow="daysToShow"
                         DatePickerMode="datePickerMode"
                         ShowAdditionalTimezones="showTimezones"
                         AdditionalTimezones="additionalTimezones"
                         ShowCarouselDatePicker="true"
                         ShowCurrentTimeMarker="true"
                         CurrentTimeMarkerColor="red"
                         DefaultEventColor="cornflowerblue"
                         TimeSlotHeight="60"
                         Use24HourTime="false" />
</div>

<div class="demo-section">
    <div class="state">
        Selected day: <code>@selectedDate</code><br/>
        Last event: <code>@(provider.LastSelectedEvent ?? "—")</code><br/>
        Last time slot tap: <code>@(provider.LastSelectedAgendaTime?.ToString("g") ?? "—")</code><br/>
        Last calendar pick: <code>@(provider.LastSelectedCalendarDate?.ToString() ?? "—")</code>
    </div>
</div>

<style>
    .toggle {
        border: none;
        color: white;
        border-radius: 8px;
        font-size: 12px;
        padding: 6px 14px;
        cursor: pointer;
    }
    .toggle--purple { background: mediumpurple; }
    .toggle--slate { background: slategray; }
    .toggle--blue { background: dodgerblue; }
</style>

@code {
    SampleEventProvider provider = new();
    DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    int daysToShow = 1;
    bool showTimezones;
    AgendaDatePickerMode datePickerMode = AgendaDatePickerMode.Carousel;
    List<TimeZoneInfo> additionalTimezones = new();

    string DaysToggleText => daysToShow == 1 ? "3-Day" : "1-Day";
    string TimezoneToggleText => showTimezones ? "Hide TZ" : "Show TZ";
    string DatePickerToggleText => datePickerMode == AgendaDatePickerMode.Carousel ? "Calendar" : "Carousel";

    protected override void OnInitialized()
    {
        provider.Changed += () => InvokeAsync(StateHasChanged);

        // mirror the MAUI sample: an extra timezone ~3 hours ahead of local
        try
        {
            var targetOffset = TimeZoneInfo.Local.BaseUtcOffset + TimeSpan.FromHours(3);
            var tz = TimeZoneInfo.GetSystemTimeZones()
                .OrderBy(t => Math.Abs((t.BaseUtcOffset - targetOffset).TotalMinutes))
                .FirstOrDefault();
            additionalTimezones.Add(tz ?? TimeZoneInfo.Utc);
        }
        catch
        {
            additionalTimezones.Add(TimeZoneInfo.Utc);
        }
    }

    void ToggleDays() => daysToShow = daysToShow == 1 ? 3 : 1;
    void ToggleTimezones() => showTimezones = !showTimezones;
    void ToggleDatePickerMode() => datePickerMode = datePickerMode == AgendaDatePickerMode.Carousel
        ? AgendaDatePickerMode.Calendar
        : AgendaDatePickerMode.Carousel;
}
