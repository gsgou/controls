@page "/camera"
@using Shiny.Blazor.Controls.Camera
@using Shiny.Controls.Camera

<PageTitle>Camera</PageTitle>

<h1>Camera</h1>

<div class="demo-section">
    <p>
        Live <code>getUserMedia</code> preview with in-browser barcode scanning (native
        <code>BarcodeDetector</code> — Chromium browsers). Face, motion, OCR and document detectors are
        MAUI-native; the browser exposes only barcode detection.
    </p>

    <div style="position:relative;width:100%;max-width:480px;aspect-ratio:3/4;border-radius:12px;overflow:hidden;background:#000;">
        <CameraView @ref="camera"
                    Facing="facing"
                    CameraId="@cameraId"
                    EnableBarcode="enableBarcode"
                    ShowOverlay="showBoxes"
                    Filter="filter"
                    BarcodeDetected="OnBarcode"
                    OnError="OnError"
                    OnStarted="LoadCamerasAsync"
                    Style="width:100%;height:100%;" />
    </div>

    <!-- camera controls -->
    <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <button @onclick="Capture">Photo</button>
        <button @onclick="ToggleRecording">@(recording ? "Stop" : "Record")</button>
        <button @onclick="Flip">Flip</button>
        <button @onclick="ToggleRunning">@(running ? "Stop" : "Start")</button>
    </div>

    <!-- options (mirrors the MAUI options sheet, where the browser supports it) -->
    <div style="margin-top:16px;display:flex;gap:24px;flex-wrap:wrap;">
        <fieldset style="border:1px solid #E5E7EB;border-radius:8px;padding:8px 14px;">
            <legend style="font-size:12px;color:#6B7280;">Detectors</legend>
            <label style="display:block;"><input type="checkbox" @bind="enableBarcode" /> Barcode / QR</label>
            <p style="margin:6px 0 0;font-size:12px;color:#9CA3AF;">Face / Motion / OCR / Documents — MAUI only</p>
        </fieldset>

        <fieldset style="border:1px solid #E5E7EB;border-radius:8px;padding:8px 14px;">
            <legend style="font-size:12px;color:#6B7280;">Camera</legend>
            <label style="display:block;"><input type="checkbox" @bind="showBoxes" /> Detection boxes</label>
            <label style="display:block;margin-top:6px;">Filter:
                <select @bind="filter">
                    @foreach (var f in Enum.GetValues<CameraFilter>())
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </label>
            <label style="display:block;margin-top:6px;">Lens:
                <select value="@cameraId" @onchange="OnLensChanged" disabled="@(cameras.Count == 0)">
                    @foreach (var c in cameras)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </label>
        </fieldset>
    </div>

    @if (lastPhoto != null)
    {
        <div style="margin-top:16px;">
            <img src="@lastPhoto" alt="Captured frame"
                 style="max-width:100%;border:1px solid #E5E7EB;border-radius:8px;" />
        </div>
    }

    @if (lastVideo != null)
    {
        <div style="margin-top:16px;">
            <video src="@lastVideo" controls
                   style="max-width:100%;border:1px solid #E5E7EB;border-radius:8px;"></video>
        </div>
    }

    <div class="state" style="margin-top:12px;">Status: <code>@status</code></div>

    @if (barcodes.Count > 0)
    {
        <ul style="margin-top:8px;">
            @foreach (var b in barcodes)
            {
                <li><strong>@b.Format</strong> — <code>@b.Value</code></li>
            }
        </ul>
    }
</div>

@code {
    CameraView? camera;
    string status = "Starting…";
    string? lastPhoto;
    string? lastVideo;
    bool recording;
    bool running = true;   // AutoStart defaults true
    CameraFacing facing = CameraFacing.Back;
    string? cameraId;
    CameraFilter filter = CameraFilter.None;
    bool enableBarcode = true;
    bool showBoxes = true;
    readonly List<CameraBarcode> barcodes = [];
    readonly List<CameraDevice> cameras = [];

    async Task LoadCamerasAsync()
    {
        if (camera == null)
            return;
        var list = await camera.GetAvailableCamerasAsync();
        cameras.Clear();
        cameras.AddRange(list);
        StateHasChanged();
    }

    void OnLensChanged(ChangeEventArgs e)
    {
        cameraId = (string?)e.Value;
        status = $"Lens: {cameras.FirstOrDefault(c => c.Id == cameraId)?.Name ?? cameraId}";
    }

    void Flip()
    {
        facing = facing == CameraFacing.Back ? CameraFacing.Front : CameraFacing.Back;
        cameraId = null;   // let the facing hint pick the lens (the component restarts on the change)
    }

    async Task ToggleRunning()
    {
        if (camera == null)
            return;
        if (running)
        {
            await camera.StopAsync();
            running = false;
        }
        else
        {
            await camera.StartAsync();   // raises OnStarted → LoadCamerasAsync
            running = true;
        }
    }

    async Task ToggleRecording()
    {
        if (camera == null)
            return;
        if (!recording)
        {
            await camera.StartRecordingAsync();
            recording = true;
            status = "Recording…";
        }
        else
        {
            var bytes = await camera.StopRecordingAsync();
            recording = false;
            if (bytes.Length > 0)
            {
                lastVideo = "data:video/webm;base64," + Convert.ToBase64String(bytes);
                status = $"Recorded {bytes.Length / 1024} KB";
            }
        }
    }

    void OnBarcode(CameraBarcode barcode)
    {
        if (!barcodes.Any(b => b.Value == barcode.Value && b.Format == barcode.Format))
            barcodes.Insert(0, barcode);
        status = $"{barcode.Format}: {barcode.Value}";
        StateHasChanged();
    }

    void OnError(string message)
    {
        status = message;
        StateHasChanged();
    }

    async Task Capture()
    {
        if (camera == null)
            return;
        var bytes = await camera.CapturePhotoAsync();
        if (bytes.Length > 0)
        {
            lastPhoto = "data:image/jpeg;base64," + Convert.ToBase64String(bytes);
            status = $"Captured {bytes.Length / 1024} KB";
        }
    }
}
