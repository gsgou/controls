@page "/kitchensink"
@using Shiny.Blazor.Controls.Chat
@using Sample.Blazor.Chat
@inject KitchenSinkChatProvider ChatProvider

<h3>Kitchen Sink</h3>
<p class="ks-lede">Demonstrates integrated components: FabMenu chat picker + Sheet with a provider-driven ChatView.</p>

<div class="ks-stage">
    <div class="ks-stage-copy">
        <h2>Kitchen Sink</h2>
        <p>Tap the chat button to pick a conversation</p>
    </div>

    <FabMenu Items="chatMenuItems"
             Text="Chats"
             FabBackgroundColor="#6C63FF"
             HasBackdrop="true"
             CloseOnBackdropTap="true"
             CloseOnItemTap="true"
             ItemTapped="OnChatMenuItemTapped" />
</div>

<SheetView @bind-IsOpen="isChatOpen"
           Detents="sheetDetents"
           SheetBackgroundColor="var(--shiny-color-surface, #FFFFFF)"
           SheetCornerRadius="20">
    <HeaderTemplate>
        <div class="ks-chat-header">
            <strong>@chatTitle</strong>
        </div>
    </HeaderTemplate>
    <SheetContent>
        @* Fills the sheet's visible band at whatever detent it is resting at, so the ChatView's
           own input bar stays on screen instead of being pushed below the fold. *@
        <div class="ks-chat-host">
            <ChatView Provider="ChatProvider"
                      SessionId="@activeSessionId"
                      PlaceholderText="Type a message..." />
        </div>
    </SheetContent>
</SheetView>

@code {
    bool isChatOpen;
    string chatTitle = string.Empty;
    string? activeSessionId;

    IList<DetentValue> sheetDetents = new List<DetentValue> { DetentValue.Half, DetentValue.Full };

    readonly List<FabMenuItem> chatMenuItems = new()
    {
        new FabMenuItem { Text = "Alice Johnson", Icon = "\U0001F3D4", FabBackgroundColor = "#E3F2FD", Tag = "alice" },
        new FabMenuItem { Text = "Bob Smith",     Icon = "\U0001F3C8", FabBackgroundColor = "#FFF3E0", Tag = "bob" },
        new FabMenuItem { Text = "Carol Davis",   Icon = "\U0001F5D3", FabBackgroundColor = "#F3E5F5", Tag = "carol" },
    };

    void OnChatMenuItemTapped(FabMenuItem item)
    {
        var participantId = item.Tag?.ToString();
        if (participantId is null) return;

        var contact = KitchenSinkChatProvider.Contacts.FirstOrDefault(c => c.Id == participantId);
        if (contact is null) return;

        chatTitle = contact.DisplayName;
        activeSessionId = contact.Id;
        isChatOpen = true;
    }
}
