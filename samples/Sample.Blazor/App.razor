@namespace Sample.Blazor

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* MainLayout is rendered by the RouteView below, so a value cascaded here reaches it. That is
           how the source-code panel in the layout knows which page it is under, without reflecting
           over route attributes. *@
        <CascadingValue Value="@routeData.PageType">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        </CascadingValue>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
