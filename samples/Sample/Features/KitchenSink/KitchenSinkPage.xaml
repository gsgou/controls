<?xml version="1.0" encoding="utf-8" ?>
<shiny:ShinyContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="http://shiny.net/maui/controls"
    xmlns:local="clr-namespace:Sample.Features.KitchenSink"
    x:Class="Sample.Features.KitchenSink.KitchenSinkPage"
    x:DataType="local:KitchenSinkViewModel"
    Title="Kitchen Sink">

  <shiny:ShinyContentPage.PageContent>
    <Grid>

        <!-- Main content -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="Kitchen Sink"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Tap the chat button to pick a conversation"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- FabMenu: open chats. The margin keeps it (and its pills) off the screen edge. -->
        <shiny:FabMenu Text="Chats"
                       FabBackgroundColor="#6C63FF"
                       TextColor="White"
                       HasBackdrop="True"
                       CloseOnBackdropTap="True"
                       CloseOnItemTap="True"
                       Margin="0,0,24,24">
            <shiny:FabMenuItem Text="Alice Johnson"
                               Icon="dotnet_bot.png"
                               FabBackgroundColor="#E3F2FD"
                               Command="{Binding OpenChatCommand}"
                               CommandParameter="alice" />
            <shiny:FabMenuItem Text="Bob Smith"
                               Icon="dotnet_bot.png"
                               FabBackgroundColor="#FFF3E0"
                               Command="{Binding OpenChatCommand}"
                               CommandParameter="bob" />
            <shiny:FabMenuItem Text="Carol Davis"
                               Icon="dotnet_bot.png"
                               FabBackgroundColor="#F3E5F5"
                               Command="{Binding OpenChatCommand}"
                               CommandParameter="carol" />
        </shiny:FabMenu>

    </Grid>
  </shiny:ShinyContentPage.PageContent>

  <shiny:ShinyContentPage.Panels>
    <!-- Sheet: chat window -->
    <!--
      Detents (not FitContent) so the sheet can be dragged between half and full height, and
      IsContentScrollEnabled=False so the ChatView owns its own scrolling and fills the panel
      instead of being nested in the panel's ScrollView at a fixed height.
    -->
    <shiny:FloatingPanel IsOpen="{Binding IsChatOpen}"
                         Detents="{Binding SheetDetents}"
                         IsContentScrollEnabled="False"
                         ExpandOnInputFocus="True"
                         HasBackdrop="True"
                         CloseOnBackdropTap="True"
                         HandleColor="Gray"
                         PanelCornerRadius="20">
        <shiny:FloatingPanel.HeaderTemplate>
            <Border BackgroundColor="#6C63FF"
                    Padding="16,12"
                    StrokeThickness="0">
                <Label Text="{Binding ChatTitle}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Border>
        </shiny:FloatingPanel.HeaderTemplate>

        <shiny:ChatView Provider="{Binding ChatProvider}"
                        SessionId="{Binding ActiveSessionId}"
                        PlaceholderText="Type a message...">
            <shiny:ChatView.MessageTemplateSelector>
                <local:KitchenSinkMessageTemplateSelector>
                    <local:KitchenSinkMessageTemplateSelector.TextTemplate>
                        <DataTemplate x:DataType="shiny:ChatMessage">
                            <Label Text="{Binding Body}" />
                        </DataTemplate>
                    </local:KitchenSinkMessageTemplateSelector.TextTemplate>
                    <local:KitchenSinkMessageTemplateSelector.ImageTemplate>
                        <DataTemplate x:DataType="shiny:ChatMessage">
                            <shiny:ImageViewer Source="{Binding ImageUrl}"
                                               HeightRequest="200"
                                               WidthRequest="280"
                                               Aspect="AspectFill" />
                        </DataTemplate>
                    </local:KitchenSinkMessageTemplateSelector.ImageTemplate>
                </local:KitchenSinkMessageTemplateSelector>
            </shiny:ChatView.MessageTemplateSelector>
        </shiny:ChatView>
    </shiny:FloatingPanel>
  </shiny:ShinyContentPage.Panels>

</shiny:ShinyContentPage>
