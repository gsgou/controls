<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MauiVersion>10.0.71</MauiVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Graphics" Version="$(MauiVersion)" />
    <PackageVersion Include="Markdig" Version="1.2.0" />
    <PackageVersion Include="Shiny.Speech" Version="2.1.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- CameraView AI document scanner: provider-agnostic Microsoft.Extensions.AI (IChatClient + structured output) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />
  </ItemGroup>
  <!-- CameraView: Android CameraX + MLKit bindings (android TFM only) -->
  <ItemGroup>
    <PackageVersion Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Video" Version="1.6.1" />
    <PackageVersion Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.7" />
    <PackageVersion Include="Xamarin.Google.MLKit.FaceDetection" Version="116.1.7.7" />
    <PackageVersion Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.7" />
    <!-- CameraView: OpenCvSharp for the Windows document rectifier (windows TFM only; official runtime) -->
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageVersion Include="Shiny.Maui.Shell" Version="6.3.1" />
    <!-- maui-labs desktop hosts (preview/CI builds via dotnet10 feed in NuGet.config) -->
    <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.10.26309.1" />
    <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.10.26309.1" />
    <PackageVersion Include="Platform.Maui.Linux.Gtk4" Version="0.6.0" />
    <PackageVersion Include="Platform.Maui.Linux.Gtk4.Essentials" Version="0.6.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.26170.4" />
    <PackageVersion Include="Microsoft.Maui.DevFlow.Driver" Version="0.1.0-preview.26170.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TUnit" Version="1.43.11" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>