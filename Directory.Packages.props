<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <MauiVersion>10.0.60</MauiVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageVersion Include="Markdig" Version="1.2.0" />
        <PackageVersion Include="Shiny.Speech" Version="2.1.0" />
        <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
        <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
        <PackageVersion Include="Shiny.Maui.Shell" Version="6.1.1" />
        <!-- maui-labs desktop hosts (preview/CI builds via dotnet10 feed in NuGet.config) -->
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.10.26276.1" />
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.10.26276.1" />
        <PackageVersion Include="Platform.Maui.Linux.Gtk4" Version="0.6.0" />
        <PackageVersion Include="Platform.Maui.Linux.Gtk4.Essentials" Version="0.6.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="coverlet.collector" Version="10.0.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.9.26258.5" />
        <PackageVersion Include="Microsoft.Maui.DevFlow.Driver" Version="0.1.0-preview.9.26258.5" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="TUnit" Version="1.43.11" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>
</Project>